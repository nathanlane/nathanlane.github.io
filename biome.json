{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": ["**", "!**/public/katex"]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"formatWithErrors": true,
		"includes": [
			"**",
			"!**/*.astro",
			"!**/tsconfig.json",
			"!**/package.json",
			"!**/vitest.config.ts",
			"!**/.claude/**",
			"!**/*.css",
			"!**/biome.json"
		]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"includes": ["**", "!**/public/katex/**", "!**/scripts/archive/**"],
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noSvgWithoutTitle": "off"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noUnknownAtRules": {
					"level": "error",
					"options": { "ignore": ["tailwind"] }
				}
			},
			"complexity": {
				"noForEach": "off"
			},
			"style": {
				"useNodejsImportProtocol": "warn",
				"useTemplate": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"trailingCommas": "all",
			"semicolons": "always"
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
