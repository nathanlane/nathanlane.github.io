# Git Secret Scanner Configuration
# This file configures the pre-commit hook's secret detection behavior

# Paths to exclude from secret scanning (uses grep -E regex)
# These are typically documentation, test files, or directories with false positives
exclude_paths:
  - "private_notes/"
  - "CHANGELOG"
  - "Changelog"
  - "SECURITY"
  - "README"
  - "CLAUDE\.md"
  - "\.test\."
  - "\.spec\."
  - "docs/"
  - "documentation/"

# Additional patterns that indicate documentation context
# If these words appear near potential secrets, it's likely documentation
doc_context_words:
  - "detect"
  - "pattern"
  - "check"
  - "scan"
  - "audit"
  - "document"
  - "example"
  - "test"
  - "sample"
  - "demo"
  - "tutorial"
  - "guide"
  - "prevents"
  - "searches for"
  - "looks for"

# Known safe patterns (these will be ignored)
# Use these for patterns that frequently cause false positives in your codebase
safe_patterns:
  - "WEBMENTION_API_KEY properly configured"
  - "api_key, apikey, access_token"  # When listing multiple patterns
  - "Detects patterns:"
  - "patterns: api"