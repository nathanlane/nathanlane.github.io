    "mdast-util-to-string": "^4.0.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-directive": "^3.0.0",
    "remark-math": "^6.0.0",
    "satori": "0.12.0",
    "satori-html": "^0.3.2",
    "sharp": "^0.34.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^1.9.4",
    "@iconify-json/hugeicons": "^1.2.3",
