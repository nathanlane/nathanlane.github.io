{
	"name": "nathanlane.github.io",
	"version": "1.0.0",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "astro dev --port 4321",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*.{astro,css,yaml,yml,html}\" tsconfig.json package.json vitest.config.ts biome.json --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"format:check": "biome format . && prettier --check \"**/*.{astro,css,yaml,yml,html}\" tsconfig.json package.json vitest.config.ts biome.json --ignore-unknown",
		"generate:cms": "node scripts/maintenance/generate-cms-config.mjs",
		"check:cms": "node scripts/maintenance/generate-cms-config.mjs --check",
		"generate:katex": "node scripts/maintenance/generate-katex-assets.mjs",
		"check:katex": "node scripts/maintenance/generate-katex-assets.mjs --check",
		"generate:social-card": "node scripts/maintenance/generate-social-card.mjs",
		"check:social-card": "node scripts/maintenance/generate-social-card.mjs --check",
		"generate:assistant-docs": "node scripts/maintenance/sync-assistant-docs.mjs",
		"check:assistant-docs": "node scripts/maintenance/sync-assistant-docs.mjs --check",
		"check:generated": "pnpm run check:cms && pnpm run check:katex",
		"check": "astro check",
		"check:all": "pnpm run lint && pnpm run format:check && pnpm run check:generated && pnpm run check && pnpm run test && pnpm run build",
		"fix:all": "pnpm run lint:fix && pnpm run format && pnpm run check",
		"clean": "rm -rf dist .astro node_modules/.cache",
		"smoke": "node scripts/validation/smoke-test.mjs",
		"smoke:local": "node scripts/validation/smoke-test.mjs http://localhost:4321",
		"smoke:prod": "node scripts/validation/smoke-test.mjs https://nathanlane.info",
		"smoke:pages": "node scripts/validation/pages-origin-redirect-smoke.mjs",
		"smoke:live": "pnpm run smoke:prod && pnpm run smoke:pages",
		"sync": "bash scripts/maintenance/sync-main.sh",
		"verify:deploy": "bash scripts/validation/verify-deploy.sh",
		"test": "vitest --run",
		"test:ui": "vitest --ui",
		"validate": "node scripts/validation/pre-push-check.js",
		"cms": "decap-server"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.2.2",
		"@astrojs/mdx": "^4.3.7",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@astrojs/tailwind": "6.0.2",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@iconify-json/lucide": "^1.2.123",
		"@shikijs/transformers": "^4.4.3",
		"@types/js-yaml": "^4.0.9",
		"astro": "^5.18.2",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"github-slugger": "^2.0.0",
		"hastscript": "^9.0.1",
		"js-yaml": "^5.3.0",
		"katex": "^0.18.4",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"rehype-pretty-code": "^0.14.5",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"remark-math": "^6.0.0",
		"satori": "0.29.0",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@biomejs/biome": "^1.9.4",
		"@iconify-json/hugeicons": "^1.2.6",
		"@iconify-json/solar": "^1.2.2",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.16",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"decap-server": "^3.3.0",
		"gray-matter": "^4.0.3",
		"jsdom": "^27.0.0",
		"prettier": "^3.6.2",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"reading-time": "^1.5.0",
		"tailwindcss": "^3.4.17",
		"tailwindcss-fluid-type": "^2.0.7",
		"typescript": "^5.8.3",
		"vite": "^6.4.3",
		"vitest": "^4.1.0"
	}
}
