    "@types/mdast": "^4.0.4",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "reading-time": "^1.5.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-fluid-type": "^2.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "tar-fs@2": "2.1.3",
      "tar-fs@3": "3.0.9",
