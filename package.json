    "@fontsource-variable/newsreader": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/ibm-plex-serif": "^5.2.6",
    "@iconify-json/lucide": "^1.2.57",
    "@shikijs/transformers": "^1.25.1",
    "@types/js-yaml": "^4.0.9",
    "astro": "^5.11.0",
    "astro-icon": "^1.1.5",
    "astro-robots-txt": "^1.0.0",
    "astro-webmanifest": "^1.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hastscript": "^9.0.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.22",
    "marked": "^16.1.0",
