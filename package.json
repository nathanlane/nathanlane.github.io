{
	"name": "nathanlane.github.io",
	"version": "1.0.0",
	"scripts": {
		"dev": "astro dev --port 4321",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"format:check": "biome format . && prettier --check \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown",
		"generate:cms": "node scripts/maintenance/generate-cms-config.mjs",
		"check:cms": "node scripts/maintenance/generate-cms-config.mjs --check",
		"generate:social-card": "node scripts/maintenance/generate-social-card.mjs",
		"check:social-card": "node scripts/maintenance/generate-social-card.mjs --check",
		"generate:assistant-docs": "node scripts/maintenance/sync-assistant-docs.mjs",
		"check:assistant-docs": "node scripts/maintenance/sync-assistant-docs.mjs --check",
		"check:generated": "pnpm run check:cms",
		"check": "astro check",
		"check:types": "tsc --noEmit",
		"check:all": "pnpm run lint && pnpm run format:check && pnpm run check:generated && pnpm run check && pnpm run test && pnpm run build",
		"fix:all": "pnpm run lint:fix && pnpm run format && pnpm run check",
		"clean": "rm -rf dist .astro node_modules/.cache",
		"smoke": "node scripts/validation/smoke-test.mjs",
		"smoke:local": "node scripts/validation/smoke-test.mjs http://localhost:4321",
		"smoke:prod": "node scripts/validation/smoke-test.mjs https://nathanlane.info",
		"smoke:pages": "node scripts/validation/pages-origin-redirect-smoke.mjs",
		"smoke:live": "pnpm run smoke:prod && pnpm run smoke:pages",
		"test": "vitest --run",
		"test:ui": "vitest --ui",
		"pre-push": "pnpm run validate",
		"validate": "node scripts/validation/pre-push-check.js",
		"cms": "decap-server"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^6.3.8",
		"@astrojs/mdx": "^4.3.7",
		"@astrojs/rss": "4.0.12",
		"@astrojs/sitemap": "3.6.0",
		"@astrojs/tailwind": "6.0.2",
		"@fontsource-variable/inter": "^5.2.6",
		"@fontsource/inter": "^5.2.6",
		"@fontsource/jetbrains-mono": "^5.2.6",
		"@iconify-json/lucide": "^1.2.57",
		"@shikijs/transformers": "^1.29.2",
		"@types/js-yaml": "^4.0.9",
		"astro": "^5.18.2",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"github-slugger": "^2.0.0",
		"hastscript": "^9.0.1",
		"js-yaml": "^4.2.0",
		"katex": "^0.16.22",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"rehype-pretty-code": "^0.14.1",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^3.0.1",
		"remark-math": "^6.0.0",
		"satori": "0.12.0",
		"satori-html": "^0.3.2",
		"sharp": "^0.34.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@biomejs/biome": "^1.9.4",
		"@iconify-json/hugeicons": "^1.2.6",
		"@iconify-json/solar": "^1.2.2",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.16",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"decap-server": "^3.3.0",
		"gray-matter": "^4.0.3",
		"jsdom": "^27.0.0",
		"prettier": "^3.6.2",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"reading-time": "^1.5.0",
		"tailwindcss": "^3.4.17",
		"tailwindcss-fluid-type": "^2.0.7",
		"typescript": "^5.8.3",
		"vite": "^6.4.3",
		"vitest": "^4.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild",
			"sharp"
		],
		"overrides": {
			"tar-fs@2": "2.1.4",
			"tar-fs@3": "3.1.2",
			"@astrojs/language-server": "2.16.10",
			"@iconify/tools": "4.2.0",
			"express": "4.22.2",
			"sucrase": "3.35.1",
			"ajv": "8.20.0",
			"svgo": "3.3.3",
			"prismjs": "1.30.0",
			"undici": "6.26.0",
			"smol-toml": "1.6.1",
			"picomatch@2": "2.3.2",
			"yaml": "2.9.0",
			"path-to-regexp": "0.1.13",
			"postcss": "8.5.15",
			"cssstyle": "5.3.7",
			"ws": "8.21.0",
			"brace-expansion": "2.0.3",
			"axios@>=1.0.0 <1.12.0": "^1.12.0",
			"defu@<6.1.5": "^6.1.5",
			"devalue@>=5.0.0 <5.6.2": "^5.6.2",
			"diff@>=5.0.0 <5.2.2": "^5.2.2",
			"fast-uri@>=3.0.0 <3.1.1": "^3.1.1",
			"fast-xml-parser@>=5.0.0 <5.3.4": "^5.3.4",
			"follow-redirects@<1.16.0": "^1.16.0",
			"glob@>=10.0.0 <10.5.0": "^10.5.0",
			"h3@>=1.0.0 <1.15.6": "^1.15.6",
			"mdast-util-to-hast@>=13.0.0 <13.2.1": "^13.2.1",
			"simple-git@>=3.0.0 <3.32.0": "^3.32.0"
		}
	},
	"overrides": {
		"tar-fs": "3.1.2",
		"prismjs": "1.30.0",
		"undici": "6.26.0",
		"brace-expansion": "2.0.3"
	}
}
