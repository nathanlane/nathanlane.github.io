---
// No props needed - this is static contact information
---

<div class="contact-info">
  <div class="contact-details">
    <div class="contact-item">
      <span class="contact-label">Email</span>
      <a href="mailto:nathanlane@example.com" class="inline-link">nathanlane@example.com</a>
    </div>
    
    <div class="contact-item">
      <span class="contact-label">Research</span>
      <a href="/research/" class="inline-link">Browse all papers</a>
    </div>
    
    <div class="contact-item">
      <span class="contact-label">Writing</span>
      <a href="/posts/" class="inline-link">Recent essays</a>
    </div>
    
    <div class="contact-item">
      <span class="contact-label">Updates</span>
      <a href="/rss.xml" class="inline-link">RSS feed</a>
    </div>
  </div>
</div>

<style>
  .contact-info {
    margin-bottom: var(--space-12); /* 72px */
  }



  .contact-details {
    /* Simple vertical flow */
  }

  .contact-item {
    margin-bottom: var(--space-2); /* 12px */
    display: flex;
    gap: var(--space-2); /* 12px */
    align-items: baseline;
  }

  .contact-item:last-child {
    margin-bottom: 0;
  }

  .contact-label {
    font-family: var(--font-sans);
    font-size: var(--step--1); /* 12.8-14.4px */
    font-variant: small-caps;
    letter-spacing: 0.075em;
    color: var(--theme-color-600);
    font-weight: 500;
    min-width: 4rem; /* Align labels consistently */
    flex-shrink: 0;
  }

  /* Dark mode adjustments */

  :global([data-theme="dark"]) .contact-label {
    color: var(--theme-color-400);
  }

  /* Mobile adjustments */
  @media (max-width: 640px) {
    .contact-item {
      flex-direction: column;
      gap: var(--space-1); /* 6px */
    }
    
    .contact-label {
      min-width: auto;
    }
  }
</style> 