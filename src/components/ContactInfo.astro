---
interface ContactItem {
  label: string;
  href: string;
  text: string;
}

interface Props {
  class?: string;
  variant?: 'default' | 'compact' | 'sidebar';
  items?: ContactItem[];
}

const { class: className = '', variant = 'default', items } = Astro.props;

// Default contact items (fallback if no items provided)
const defaultItems: ContactItem[] = [
  {
    label: "Email",
    href: "mailto:drnathanlane@gmail.com",
    text: "drnathanlane@gmail.com"
  },
  {
    label: "Research", 
    href: "/research/",
    text: "Browse all papers"
  },
  {
    label: "Writing",
    href: "/posts/",
    text: "Recent essays"
  },
  {
    label: "Updates",
    href: "/rss.xml", 
    text: "RSS feed"
  }
];

const contactItems = items || defaultItems;
---

<div class={`contact-info contact-info--${variant} ${className}`}>
  <div class="contact-details">
    {contactItems.map((item) => (
      <div class="contact-item">
        <span class="contact-label">{item.label}</span>
        <a href={item.href} class="inline-link">{item.text}</a>
      </div>
    ))}
  </div>
</div>

<style>
  /* Base contact info styling */
  .contact-info {
    /* No bottom margin by default - let parent control spacing */
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-3); /* 18px - consistent with global spacing */
  }

  .contact-item {
    display: flex;
    gap: var(--space-3); /* 18px - comfortable gap between label and link */
    align-items: baseline;
    min-height: var(--space-4); /* 24px - baseline grid aligned */
  }

  .contact-label {
    /* Use the established metadata typography system */
    font-family: var(--font-sans);
    font-size: var(--step--1); /* 12.8-14.4px - established size */
    font-weight: 450; /* Match text-meta weight */
    color: var(--theme-color-500); /* Match text-meta color */
    
    /* Real small caps following Bringhurst principles */
    font-feature-settings:
      "kern" 1,       /* Essential kerning */
      "smcp" 1,       /* Real small caps */
      "c2sc" 1,       /* Caps to small caps */
      "case" 1;       /* Case-sensitive forms */
    
    letter-spacing: 0.03em; /* Match refined text-meta tracking */
    line-height: 1.4; /* Match text-meta line height */
    
    min-width: 4.5rem; /* Consistent label alignment */
    flex-shrink: 0;
  }

  /* Link styling - inherit from global inline-link but ensure consistency */
  .contact-item .inline-link {
    font-size: var(--step-0); /* Base text size */
    font-weight: 400; /* Normal weight for readability */
  }

  /* Variant: Compact - for sidebars or tight spaces */
  .contact-info--compact .contact-details {
    gap: var(--space-2); /* 12px - tighter spacing */
  }
  
  .contact-info--compact .contact-item {
    gap: var(--space-2); /* 12px - tighter gap */
  }
  
  .contact-info--compact .contact-label {
    min-width: 3.5rem; /* Smaller minimum width */
    font-size: var(--step--2); /* Smaller text */
  }
  
  .contact-info--compact .inline-link {
    font-size: var(--step--1); /* Smaller link text */
  }

  /* Variant: Sidebar - for narrow contexts */
  .contact-info--sidebar .contact-item {
    flex-direction: column;
    gap: var(--space-1); /* 6px - minimal gap for stacked layout */
    align-items: flex-start;
  }
  
  .contact-info--sidebar .contact-label {
    min-width: auto;
  }

  /* Dark mode adjustments - follow global color system */
  :global([data-theme="dark"]) .contact-label {
    color: var(--theme-color-400); /* Lighter in dark mode */
  }

  /* Responsive behavior - mobile-first approach */
  @media (max-width: 640px) {
    .contact-info:not(.contact-info--compact):not(.contact-info--sidebar) .contact-item {
      flex-direction: column;
      gap: var(--space-1); /* 6px - minimal gap when stacked */
      align-items: flex-start;
    }
    
    .contact-info:not(.contact-info--compact):not(.contact-info--sidebar) .contact-label {
      min-width: auto;
    }
  }
  
  /* Medium screens - optimize for scanning */
  @media (min-width: 641px) and (max-width: 1024px) {
    .contact-details {
      gap: var(--space-4); /* 24px - more breathing room on medium screens */
    }
  }

  /* Large screens - more generous spacing */
  @media (min-width: 1025px) {
    .contact-details {
      gap: var(--space-4); /* 24px - optimal for large screens */
    }
    
    .contact-item {
      gap: var(--space-4); /* 24px - generous gap for desktop */
    }
  }
</style> 