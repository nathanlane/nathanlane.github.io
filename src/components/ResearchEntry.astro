---
import { normalizeStatus } from '@/utils/date';

interface Props {
  title: string;
  href: string;
  date?: string | undefined;
  status?: 'published' | 'working-paper' | 'work-in-progress' | 'archived' | undefined;
  metadata?: string | undefined;
  description?: string | undefined;
  publication?: string | undefined;
  download?: string | undefined;
  link?: string | undefined;
}

const { 
  title, 
  href, 
  date, 
  status,
  metadata,
  description,
  publication,
  download,
  link
} = Astro.props;

// Build metadata items - research-specific formatting
const metadataItems = [
  ...(status ? [{ text: normalizeStatus(status) }] : []),
  ...(date ? [{ text: date }] : []), // Use year directly, not formatted date
  ...(metadata ? [{ text: metadata }] : [])
].filter(Boolean);


---

<article class="research-entry entry-divider">
  <!-- Title with refined typography matching MediaEntry scale -->
  <h3 class="research-title">
    <a href={href} class="link-title">{title}</a>
  </h3>
  
  <!-- Unified metadata approach -->
  <div class="research-metadata text-meta text-meta--light">
    {metadataItems.map((item, index) => (
      <>
        <span class="metadata-item">{item.text}</span>
        {index < metadataItems.length - 1 && (
          <span class="text-meta__separator" aria-hidden="true">•</span>
        )}
      </>
    ))}
  </div>
  
  <!-- Publication with refined small caps -->
  {publication && (
    <div class="text-publication">
      {publication}
    </div>
  )}
  
  <!-- Description with optimal typography -->
  {description && (
    <p class="text-research-description">{description}</p>
  )}
  
  <!-- Research action links with new styling -->
  {(link || download) && (
    <div class="research-actions">
      {link && (
        <a href={link} class="link-research-action" target="_blank" rel="noopener">
          <span>Publication</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {download && (
        <a href={download} class="link-research-action" target="_blank" rel="noopener">
          <span>PDF</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  )}
</article>

<style>
  /* Research entry container - using global .entry-divider */
  .research-entry {
    margin-bottom: var(--space-6); /* 36px - tighter spacing */
  }
  
  .research-entry:last-child {
    margin-bottom: 0;
  }
  
  /* Title typography - matching MediaEntry's refined approach */
  .research-title {
    /* INCREASED SIZE - now properly larger than body text */
    font-size: var(--step-1); /* 15.6-18px - proper hierarchy */
    font-weight: 525; /* Slightly heavier for distinction */
    line-height: 1.3; /* Tighter for impact */
    margin-bottom: var(--space-2); /* 12px - more breathing room */
    
    /* Enhanced OpenType features */
    font-feature-settings:
      "kern" 1,
      "liga" 1,
      "calt" 1;
    
    /* Ruder: slight negative tracking for display sizes */
    letter-spacing: -0.01em;
  }
  
  /* Research metadata - clean and minimal */
  .research-metadata {
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: wrap;
    line-height: 1.5;
    margin-bottom: var(--space-1); /* 6px */
  }
  
  .metadata-item {
    /* Inherits from global .text-meta system */
  }
  
  /* Publication spacing */
  .text-publication {
    margin-bottom: var(--space-2); /* 12px */
  }
  
  /* Description spacing */
  .text-research-description {
    margin-top: var(--space-2); /* 12px */
    margin-bottom: var(--space-2);
  }
  
  /* Action links container */
  .research-actions {
    display: flex;
    align-items: baseline;
    gap: var(--space-4); /* 24px - generous spacing */
    margin-top: var(--space-2); /* 12px */
  }
  
  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .research-title {
      font-weight: 600;
    }
  }
  
  /* Mobile adjustments */
  @media (max-width: 640px) {
    .research-actions {
      gap: var(--space-3); /* Tighter on mobile */
    }
  }
</style> 
