---
import MetadataLine from './MetadataLine.astro';

interface Props {
  title: string;
  href: string;
  date?: string | undefined;
  status?: 'published' | 'working-paper' | 'work-in-progress' | 'archived' | undefined;
  description: string;
  metadata?: string | undefined;
  publication?: string | undefined;
  download?: string | undefined;
  link?: string | undefined;
}

const { 
  title, 
  href, 
  date, 
  status, 
  description, 
  metadata,
  publication,
  download,
  link
} = Astro.props;

// Format date if provided
const formattedDate = date ? new Date(date).toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'short' 
}) : '';

// Build metadata items - research-specific formatting
const metadataItems = [
  { text: 'RESEARCH' },
  ...(formattedDate ? [{ text: formattedDate }] : []),
  ...(status ? [{ text: status.toUpperCase().replace('-', ' ') }] : []),
  ...(metadata ? [{ text: metadata }] : [])
].filter(Boolean);
---

<article class="research-entry">
  <h3 class="research-title">
    <a href={href} class="research-link">{title}</a>
  </h3>
  
  <MetadataLine 
    items={metadataItems}
    class="mb-3b"
  />
  
  <!-- Publication information - more prominent for research -->
  {publication && (
    <div class="research-publication">
      {publication}
    </div>
  )}
  
  <p class="research-description">{description}</p>
  
  <!-- Research-specific action links -->
  {(download || link) && (
    <div class="research-actions">
      {download && (
        <a href={download} class="research-action-link" target="_blank" rel="noopener">
          Download PDF ↗
        </a>
      )}
      {link && (
        <a href={link} class="research-action-link" target="_blank" rel="noopener">
          View Paper ↗
        </a>
      )}
    </div>
  )}
</article>

<style>
  /* Research-specific styling - more academic, formal presentation */
  .research-entry {
    margin-bottom: var(--space-10); /* 60px - more generous spacing for research */
    padding-bottom: var(--space-6); /* 36px */
    border-bottom: 1px solid var(--theme-color-200);
  }
  
  .research-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  
  /* Research title - slightly larger, more academic */
  .research-title {
    font-size: var(--step-1); /* 18.8-21.3px - larger than DocumentEntry */
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: var(--space-2b); /* 12px */
  }
  
  .research-link {
    color: var(--theme-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .research-link:hover {
    color: var(--theme-accent-base);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  
  /* Publication styling - more prominent */
  .research-publication {
    font-size: var(--step--1); /* 12.8-14.4px */
    font-weight: 600;
    color: var(--theme-accent-base);
    margin-bottom: var(--space-3b); /* 18px */
    font-style: italic;
  }
  
  /* Description with wider measure for academic content */
  .research-description {
    font-size: var(--step-0); /* 15.6-17px */
    line-height: 1.6;
    color: var(--theme-text);
    max-width: 70ch; /* Wider than standard 65ch for detailed descriptions */
    margin-bottom: var(--space-3b); /* 18px */
  }
  
  /* Research action links - more prominent */
  .research-actions {
    display: flex;
    gap: var(--space-6b); /* 36px */
    margin-top: var(--space-4b); /* 24px */
  }
  
  .research-action-link {
    font-size: var(--step--1); /* 12.8-14.4px */
    font-weight: 600;
    color: var(--theme-accent-base);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }
  
  .research-action-link:hover {
    color: var(--theme-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  
  /* Dark mode adjustments */
  :global([data-theme="dark"]) .research-publication {
    color: var(--theme-color-300);
  }
  
  :global([data-theme="dark"]) .research-action-link {
    color: var(--theme-color-300);
  }
  
  :global([data-theme="dark"]) .research-action-link:hover {
    color: var(--theme-color-100);
  }
</style> 