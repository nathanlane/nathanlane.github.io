---
import MetadataLine from './MetadataLine.astro';

interface MediaItem {
  title: string;
  outlet: string;
  date: string;
  type: string;
  link: string;
}

interface Props {
  items: MediaItem[];
}

const { items } = Astro.props;

// Format dates consistently
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
};
---

<div class="media-list">
  {items.map(item => (
    <div class="media-entry">
      <h4 class="media-title">
        <a href={item.link} class="link-inline" target="_blank" rel="noopener noreferrer">
          {item.title}
        </a>
      </h4>
      <MetadataLine 
        items={[
          { text: item.outlet, href: item.link },
          { text: item.type.toUpperCase() },
          { text: formatDate(item.date) }
        ]}
        variant="light"
        class="mb-0"
      />
    </div>
  ))}
</div>

<style>
  .media-list {
    /* No additional styling needed - let entries flow naturally */
  }

  .media-entry {
    margin-bottom: var(--space-4); /* 24px - baseline alignment */
  }

  .media-entry:last-child {
    margin-bottom: 0;
  }

  .media-title {
    font-family: var(--font-body);
    font-size: var(--step-0); /* 15.6-17px */
    font-weight: 450;
    margin-bottom: var(--space-1); /* 6px */
    line-height: 1.4;
  }

  /* Media source styling now handled by MetadataLine component */

  /* External link indicator styling already handled by global.css */
</style> 