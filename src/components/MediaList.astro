---
interface MediaItem {
  title: string;
  outlet: string;
  date: string;
  type: string;
  link: string;
}

interface Props {
  items: MediaItem[];
}

const { items } = Astro.props;

// Format dates consistently
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'short',
    day: 'numeric'
  });
};
---

<div class="media-list">
  {items.map(item => (
    <div class="media-entry">
      <h4 class="media-title">
        <a href={item.link} class="inline-link" target="_blank" rel="noopener noreferrer">
          {item.title}
        </a>
      </h4>
      <div class="media-source">
        {item.outlet} • {item.type.toUpperCase()} • {formatDate(item.date)}
      </div>
    </div>
  ))}
</div>

<style>
  .media-list {
    /* No additional styling needed - let entries flow naturally */
  }

  .media-entry {
    margin-bottom: var(--space-4); /* 24px - baseline alignment */
  }

  .media-entry:last-child {
    margin-bottom: 0;
  }

  .media-title {
    font-family: var(--font-sans);
    font-size: var(--step-0); /* 15.6-17px */
    font-weight: 450;
    margin-bottom: var(--space-1); /* 6px */
    line-height: 1.4;
  }

  .media-source {
    font-family: var(--font-sans);
    font-size: var(--step--1); /* 12.8-14.4px */
    color: var(--theme-color-600);
    font-variant: small-caps;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  /* Dark mode adjustments */
  :global([data-theme="dark"]) .media-source {
    color: var(--theme-color-400);
  }

  /* External link indicator styling already handled by global.css */
</style> 