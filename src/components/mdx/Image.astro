---
import { Image as AstroImage } from 'astro:assets';

export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  caption?: string;
}

const { 
  src, 
  alt, 
  width, 
  height, 
  loading = 'lazy',
  class: className,
  caption 
} = Astro.props;

// Determine if this is a local or remote image
const isRemote = src.startsWith('http://') || src.startsWith('https://');
---

{caption ? (
  <figure class="my-8b">
    {isRemote ? (
      <img 
        src={src} 
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        class={className || "w-full h-auto rounded-lg"}
      />
    ) : (
      <AstroImage 
        src={src} 
        alt={alt}
        width={width || 800}
        height={height || 600}
        loading={loading}
        decoding="async"
        class={className || "w-full h-auto rounded-lg"}
      />
    )}
    <figcaption class="mt-2b text-sm text-light text-center">
      {caption}
    </figcaption>
  </figure>
) : (
  isRemote ? (
    <img 
      src={src} 
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      class={className || "w-full h-auto rounded-lg my-8b"}
    />
  ) : (
    <AstroImage 
      src={src} 
      alt={alt}
      width={width || 800}
      height={height || 600}
      loading={loading}
      decoding="async"
      class={className || "w-full h-auto rounded-lg my-8b"}
    />
  )
)}