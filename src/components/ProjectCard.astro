---
export interface Props {
	title: string;
	description: string;
	url?: string;
	class?: string;
}

const { title, description, url, class: className = "" } = Astro.props;
---

<article class={`group rounded-lg bg-color-75 hover:bg-color-100 ${className} p-space-s card`} data-context="component">
	<div class="flex flex-col gap-space-2xs">
		{url ? (
			<h3 class="font-headline font-medium text-1 leading-tight">
				<a href={url} class="link-inline hover:text-accent-base">
					{title}
				</a>
			</h3>
		) : (
			<h3 class="font-headline font-medium text-1 leading-tight text-accent-base">
				{title}
			</h3>
		)}
		<p class="text-body-sm text-light line-clamp-3">
			{description}
		</p>
	</div>
</article>