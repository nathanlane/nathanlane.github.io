---
import ContactInfo from './ContactInfo.astro';

interface Props {
  title?: string;
  variant?: 'default' | 'compact' | 'sidebar';
  class?: string;
  showTitle?: boolean;
}

const { 
  title = "Contact & Links", 
  variant = 'default',
  class: className = '',
  showTitle = true
} = Astro.props;
---

<div class={`contact-box contact-box--${variant} ${className}`}>
  {showTitle && (
    <h3 class="contact-box__title heading-3">{title}</h3>
  )}
  <ContactInfo variant={variant} />
</div>

<style>
  .contact-box {
    /* Base container styling */
  }

  .contact-box__title {
    margin-bottom: var(--space-6); /* 36px - proper separation */
    color: var(--theme-text);
  }

  /* Variant styling */
  .contact-box--compact .contact-box__title {
    margin-bottom: var(--space-4); /* 24px - tighter for compact variant */
    font-size: var(--step-1); /* Smaller title for compact variant */
  }

  .contact-box--sidebar .contact-box__title {
    margin-bottom: var(--space-4); /* 24px - sidebar spacing */
    font-size: var(--step-1); /* Appropriate size for sidebar */
  }

  /* Dark mode adjustments */
  :global([data-theme="dark"]) .contact-box__title {
    color: var(--theme-text);
  }
</style>