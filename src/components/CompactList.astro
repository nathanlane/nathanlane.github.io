---
export interface Props {
	items: Array<{
		title: string;
		description?: string;
		url?: string;
		date?: Date;
	}>;
	class?: string;
	showDescriptions?: boolean;
}

const { items, class: className = "", showDescriptions = true } = Astro.props;
---

<ul class={`compact-list ${className}`} role="list">
	{items.map((item) => (
		<li class="compact-entry">
			<div class="entry-content">
				{item.url ? (
					<a href={item.url} class="entry-link link-title">
						<h3 class="entry-title">
							{item.title}
						</h3>
					</a>
				) : (
					<h3 class="entry-title">
						{item.title}
					</h3>
				)}
				
				{item.date && (
					<time class="entry-date" datetime={item.date.toISOString()}>
						{item.date.getFullYear()}
					</time>
				)}
			</div>
			
			{showDescriptions && item.description && (
				<p class="entry-description">
					{item.description}
				</p>
			)}
		</li>
	))}
</ul>

<style>
	/* Remove default list styling */
	.compact-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	/* Entry container with refined spacing */
	.compact-entry {
		/* Generous vertical padding for comfortable scanning */
		padding-top: var(--space-3); /* 18px */
		padding-bottom: var(--space-3); /* 18px */
		
		/* Subtle separator line */
		border-bottom: 1px solid var(--theme-color-150);
		
		/* Remove transition for cleaner interaction */
		position: relative;
	}

	/* Remove border from last item */
	.compact-entry:last-child {
		border-bottom: none;
	}

	/* Main content row */
	.entry-content {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4); /* 24px - comfortable spacing */
	}

	/* Title styling following Hochuli's principles */
	.entry-title {
		/* Typography */
		font-family: var(--font-body);
		font-size: var(--step-0); /* 15.6-17px - body size */
		font-weight: 450; /* Slightly heavier for hierarchy */
		line-height: 1.4; /* Tighter leading for single lines */
		
		/* Color and hierarchy */
		color: var(--theme-text);
		
		/* Prevent wrapping on very long titles */
		margin: 0;
		flex: 1 1 auto;
	}

	/* Link styling - using consolidated system */
	.entry-link {
		/* Expand click target for better UX */
		display: block;
		
		/* Keep position relative for pseudo-element */
		position: relative;
	}

	/* Refined hover state following Butterick's restraint */
	.entry-link:hover .entry-title {
		/* Micro-expansion for tactile feedback */
		letter-spacing: 0.002em;
	}

	/* Link styling handled by consolidated .link-title class */

	/* Date styling - metadata hierarchy */
	.entry-date {
		/* Typography following site's metadata pattern */
		font-family: var(--font-body);
		font-size: var(--step--1); /* 12.8-14.4px */
		font-variant-numeric: lining-nums; /* Align numbers */
		color: var(--theme-color-500);
		
		/* Prevent shrinking */
		flex: 0 0 auto;
		
		/* Refined spacing */
		margin-left: var(--space-4); /* 24px */
	}

	/* Description styling - secondary information */
	.entry-description {
		/* Typography for comfortable reading */
		font-family: var(--font-body);
		font-size: var(--step--1); /* 12.8-14.4px */
		line-height: 1.5; /* Generous leading for small text */
		color: var(--theme-color-600);
		
		/* Spacing */
		margin-top: var(--space-1); /* 6px - tight coupling */
		margin-bottom: 0;
		
		/* Prevent overly long descriptions - tighter for better readability */
		max-width: 65ch; /* Reduced from 75ch for better scanning */
	}

	/* Responsive adjustments */
	@media (max-width: 640px) {
		/* Stack content on mobile */
		.entry-content {
			flex-direction: column;
			gap: var(--space-1); /* 6px */
			align-items: flex-start;
		}
		
		.entry-date {
			margin-left: 0;
			margin-top: var(--space-1); /* 6px */
		}
		
		/* Slightly reduce padding on mobile */
		.compact-entry {
			padding-top: var(--space-2); /* 12px */
			padding-bottom: var(--space-2); /* 12px */
		}
	}

	/* Dark mode refinements */
	:global([data-theme="dark"]) .compact-entry {
		border-bottom-color: var(--theme-color-250);
	}
	
	:global([data-theme="dark"]) .entry-date {
		color: var(--theme-color-400);
	}
	
	:global([data-theme="dark"]) .entry-description {
		color: var(--theme-color-400);
	}

	/* High contrast mode support */
	@media (prefers-contrast: high) {
		.compact-entry {
			border-bottom-width: 2px;
		}
		
		/* Focus handled by global system */
	}

	/* Print optimization */
	@media print {
		.compact-entry {
			padding: var(--space-2) 0;
			border-bottom: 1px solid var(--theme-color-300);
		}
		
		/* Print link styles now handled centrally in links.css */
	}
</style>