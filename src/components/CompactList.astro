---
export interface Props {
	items: Array<{
		title: string;
		description?: string;
		url?: string;
		date?: Date;
	}>;
	class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<div class={`space-y-3b ${className}`}>
	{items.map((item) => (
		<div class="group flex items-center justify-between py-2b border-b border-color-150 last:border-b-0">
			{item.url ? (
				<a href={item.url} class="flex-1 min-w-0">
					<div class="flex items-baseline gap-3b">
						<h3 class="font-medium text-0 leading-tight text-accent-base group-hover:text-accent-two truncate">
							{item.title}
						</h3>
						{item.description && (
							<p class="text--1 text-light truncate flex-shrink-0 max-w-xs">
								{item.description}
							</p>
						)}
					</div>
				</a>
			) : (
				<div class="flex-1 min-w-0">
					<div class="flex items-baseline gap-3b">
						<h3 class="font-medium text-0 leading-tight text-accent-base truncate">
							{item.title}
						</h3>
						{item.description && (
							<p class="text--1 text-light truncate flex-shrink-0 max-w-xs">
								{item.description}
							</p>
						)}
					</div>
				</div>
			)}
			{item.date && (
				<time class="text--1 text-lighter flex-shrink-0 ml-4b">
					{item.date.getFullYear()}
				</time>
			)}
		</div>
	))}
</div>