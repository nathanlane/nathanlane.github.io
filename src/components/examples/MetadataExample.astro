---
// Example showing the alignment fix for your metadata
import MetadataGroup from '@/components/typography/MetadataGroup.astro';

const metadataItems = [
  {
    text: 'Council on Foreign Relations',
    href: 'https://www.cfr.org/article/indias-industrial-policies-rejecting-old-status-quo-and-creating-new',
    variant: 'primary'
  },
  {
    text: 'Feb 10, 2025',
    variant: 'secondary' 
  },
  {
    text: 'Article',
    variant: 'muted'
  }
];
---

<div class="space-y-8">
  <!-- Current problematic version -->
  <div>
    <h3 class="text-sm font-semibold mb-3 text-red-600">❌ Current (Misaligned)</h3>
    <div class="metadata-line text-meta text-meta--light mb-2b">
      <a href="https://www.cfr.org/article/indias-industrial-policies-rejecting-old-status-quo-and-creating-new" 
         class="text-meta--light no-underline hover:underline">
        Council on Foreign Relations
      </a>
      <span class="text-meta__separator" aria-hidden="true"> • </span>
      <span class="text-meta--light"> Feb 10, 2025 </span>
      <span class="text-meta__separator" aria-hidden="true"> • </span>
      <span class="text-meta--light"> Article </span>
    </div>
  </div>

  <!-- Fixed version with MetadataGroup -->
  <div>
    <h3 class="text-sm font-semibold mb-3 text-green-600">✅ Fixed (Optically Aligned)</h3>
    <MetadataGroup 
      items={metadataItems}
      separator="•"
      class="mb-2b"
    />
  </div>

  <!-- Alternative separators -->
  <div>
    <h3 class="text-sm font-semibold mb-3">Alternative Separators</h3>
    <div class="space-y-2">
      <MetadataGroup items={metadataItems} separator="•" />
      <MetadataGroup items={metadataItems} separator="·" />
      <MetadataGroup items={metadataItems} separator="|" />
      <MetadataGroup items={metadataItems} separator="/" />
    </div>
  </div>
</div>