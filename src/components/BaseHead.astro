---
import { WEBMENTION_PINGBACK, WEBMENTION_URL } from "astro:env/client";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import "@/styles/global.css";

// Import fonts
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";
import "@fontsource/jetbrains-mono/400-italic.css";
import "@fontsource-variable/inter";

type Props = SiteMeta;

const { articleDate, description, ogImage, title } = Astro.props;

const titleSeparator = "•";
const siteTitle = `${title} ${titleSeparator} ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(ogImage ? ogImage : "/social-card.png", Astro.url).href;
---

<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>{siteTitle}</title>

{/* Font Preloading for Critical Fonts */}
{/* Preconnect to speed up font loading */}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{/* DNS prefetch as fallback for browsers that don't support preconnect */}
<link rel="dns-prefetch" href="https://fonts.gstatic.com" />

{/* Enhanced Font Loading Strategy - Critical Fonts with Metrics-Matched Fallbacks */}
<style>
  /* Metrics-matched fallback system to prevent layout shift */
  @font-face {
    font-family: 'Inter Fallback';
    src: local('system-ui'), local('-apple-system'), local('Segoe UI');
    font-display: block;
    ascent-override: 90%;
    descent-override: 22%;
    line-gap-override: 0%;
    size-adjust: 107%;
  }
  
  @font-face {
    font-family: 'Inter Fallback Body';
    src: local('system-ui'), local('-apple-system'), local('Segoe UI');
    font-display: block;
    ascent-override: 90%;
    descent-override: 22%;
    line-gap-override: 0%;
    size-adjust: 107%;
  }

  /* Primary font faces with optimized loading */
  @font-face {
    font-family: 'Inter';
    font-weight: 100 900;
    font-display: swap;
    src: local('Inter Variable');
  }
  
  @font-face {
    font-family: 'Inter Body';
    font-weight: 100 900;
    font-display: swap;
    src: local('Inter Variable');
  }
  
  /* JetBrains Mono loaded via @fontsource imports above */

  /* Departure Mono font face */
  @font-face {
    font-family: 'Departure Mono';
    src: url('/fonts/departure-mono/DepartureMono-Regular.woff2') format('woff2'),
         url('/fonts/departure-mono/DepartureMono-Regular.woff') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* Layout shift prevention with fallback stacks */
  :root {
    --font-headline: 'Inter Variable', 'Inter', 'Inter Fallback', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-body: 'Inter Variable', 'Inter', 'Inter Fallback', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-serif: 'Inter Variable', 'Inter', 'Inter Fallback', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'JetBrains Mono', 'Menlo', 'Monaco', 'Cascadia Code', 'Segoe UI Mono', 'Roboto Mono', monospace;
    --font-meta: 'JetBrains Mono', 'Departure Mono', 'Menlo', 'Monaco', monospace;
  }
</style>

{/* Icons */}
<link href="/icon.svg" rel="icon" type="image/svg+xml" />
{
	import.meta.env.PROD && (
		<>
			{/* Favicon & Apple Icon */}
			<link rel="icon" href="/favicon-32x32.png" type="image/png" />
			<link href="/icons/apple-touch-icon.png" rel="apple-touch-icon" />
			{/* Manifest */}
			<link href="/manifest.webmanifest" rel="manifest" />
		</>
	)
}

{/* Canonical URL */}
<link href={canonicalURL} rel="canonical" />

{/* Primary Meta Tags */}
<meta content={siteTitle} name="title" />
<meta content={description} name="description" />
<meta content={siteConfig.author} name="author" />

{/* Theme Colour */}
<meta content="" name="theme-color" />

{/* Open Graph / Facebook */}
<meta content={articleDate ? "article" : "website"} property="og:type" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalURL} property="og:url" />
<meta content={siteConfig.title} property="og:site_name" />
<meta content={siteConfig.ogLocale} property="og:locale" />
<meta content={socialImageURL} property="og:image" />
<meta content="1200" property="og:image:width" />
<meta content="630" property="og:image:height" />
{
	articleDate && (
		<>
			<meta content={siteConfig.author} property="article:author" />
			<meta content={articleDate} property="article:published_time" />
		</>
	)
}

{/* Twitter */}
<meta content="summary_large_image" property="twitter:card" />
<meta content={canonicalURL} property="twitter:url" />
<meta content={title} property="twitter:title" />
<meta content={description} property="twitter:description" />
<meta content={socialImageURL} property="twitter:image" />
{siteConfig.twitterHandle && (
  <>
    <meta content={siteConfig.twitterHandle} property="twitter:site" />
    <meta content={siteConfig.twitterHandle} property="twitter:creator" />
  </>
)}

{/* Sitemap */}
<link href="/sitemap-index.xml" rel="sitemap" />

{/* RSS auto-discovery */}
<link href="/rss.xml" rel="alternate" title={siteConfig.title} type="application/rss+xml" />



{/* KaTeX CSS for LaTeX math rendering */}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" />

{/* Webmentions */}
{
	WEBMENTION_URL && (
		<>
			<link href={WEBMENTION_URL} rel="webmention" />
			{WEBMENTION_PINGBACK && <link href={WEBMENTION_PINGBACK} rel="pingback" />}
		</>
	)
}

<meta content={Astro.generator} name="generator" />
