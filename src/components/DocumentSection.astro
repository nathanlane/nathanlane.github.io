---
interface Props {
  title: string;
  viewAllText?: string;
  viewAllHref?: string;
}

const { title, viewAllText, viewAllHref } = Astro.props;
---

<section class="document-section">
  <header class="section-header">
    <h2 class="heading-2">{title}</h2>
    {viewAllHref && viewAllText && (
      <a href={viewAllHref} class="section-link link-nav">{viewAllText}</a>
    )}
  </header>
  
  <div class="section-content">
    <slot />
  </div>
</section>

<style>
  .document-section {
    border-bottom: 1px solid var(--theme-color-300);
    padding-bottom: var(--space-8); /* 48px */
    margin-bottom: var(--space-8); /* 48px - reduced from 96px, baseline aligned */
  }

  .document-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .section-header {
    margin-bottom: var(--space-8); /* 48px */
  }



  /* Additional section link styling */
  .section-link {
    font-family: var(--font-body);
    font-size: var(--step--1); /* 12.8-14.4px */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  /* Section links use u-hover-underline pattern */
  .section-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .section-content {
    /* Single column flow */
    max-width: none; /* Let content flow naturally */
  }

  /* Dark mode adjustments */

  /* Dark mode handled by link-nav class */
</style> 