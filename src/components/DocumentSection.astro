---
interface Props {
  title: string;
  viewAllText?: string;
  viewAllHref?: string;
}

const { title, viewAllText, viewAllHref } = Astro.props;
---

<section class="document-section">
  <header class="section-header">
    <h2 class="section-title">{title}</h2>
    {viewAllHref && viewAllText && (
      <a href={viewAllHref} class="section-link">{viewAllText}</a>
    )}
  </header>
  
  <div class="section-content">
    <slot />
  </div>
</section>

<style>
  .document-section {
    border-top: 1px solid var(--border-special);
    padding-top: var(--space-8); /* 48px */
    margin-top: var(--space-8);  /* 48px */
    margin-bottom: var(--space-8); /* 48px - reduced from 96px, baseline aligned */
  }

  .document-section:first-child {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }

  .section-header {
    margin-bottom: var(--space-8); /* 48px */
  }

  .section-title {
    font-family: var(--font-newsreader);
    font-size: var(--step-2); /* 23.4-26.6px */
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3); /* 18px */
    line-height: 1.25;
    color: var(--theme-text);
  }

  .section-link {
    font-family: var(--font-sans);
    font-size: var(--step--1); /* 12.8-14.4px */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--theme-color-600);
    text-decoration: none;
    font-weight: 500;
    
    /* Subtle hover effect */
    transition: color 200ms ease-out;
  }

  .section-link:hover {
    color: var(--theme-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .section-content {
    /* Single column flow */
    max-width: none; /* Let content flow naturally */
  }

  /* Dark mode adjustments */
  :global([data-theme="dark"]) .section-title {
    font-weight: 425; /* Slightly heavier for dark mode */
  }

  :global([data-theme="dark"]) .section-link {
    color: var(--theme-color-400);
  }

  :global([data-theme="dark"]) .section-link:hover {
    color: var(--theme-color-100);
  }
</style> 