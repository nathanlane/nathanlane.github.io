---
interface Props {
  title: string;
  viewAllText?: string;
  viewAllHref?: string;
}

const { title, viewAllText, viewAllHref } = Astro.props;
---

<section class="document-section">
  <header class="section-header">
    <h2 class="heading-2">{title}</h2>
    {viewAllHref && viewAllText && (
      <a href={viewAllHref} class="section-link">{viewAllText}</a>
    )}
  </header>
  
  <div class="section-content">
    <slot />
  </div>
</section>

<style>
  .document-section {
    border-bottom: 1px solid var(--theme-color-300);
    padding-bottom: var(--space-8); /* 48px */
    margin-bottom: var(--space-8); /* 48px - reduced from 96px, baseline aligned */
  }

  .document-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .section-header {
    margin-bottom: var(--space-8); /* 48px */
  }



  /* Using consolidated link system */
  .section-link {
    @apply link-nav;
    font-family: var(--font-sans);
    font-size: var(--step--1); /* 12.8-14.4px */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .section-link:hover {
    color: var(--theme-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .section-content {
    /* Single column flow */
    max-width: none; /* Let content flow naturally */
  }

  /* Dark mode adjustments */

  :global([data-theme="dark"]) .section-link {
    color: var(--theme-color-400);
  }

  :global([data-theme="dark"]) .section-link:hover {
    color: var(--theme-color-100);
  }
</style> 