---
import { siteConfig } from '@/site.config';
// This component adds JSON-LD structured data to help search engines understand your content
import type { BreadcrumbItem, StructuredDataContent, StructuredDataProps } from '@/types';

export interface Props extends StructuredDataProps {}

const { type, data } = Astro.props;

const siteBase = Astro.site ?? Astro.url;
const configuredSiteHref = Astro.site?.toString() ?? "";
const configuredSiteHrefNoTrailingSlash = configuredSiteHref.replace(/\/$/, "");
const siteHref = siteBase?.toString() ?? "";

const absoluteUrl = (value?: string) => {
  if (!value) return undefined;
  try {
    return siteBase ? new URL(value, siteBase).href : value;
  } catch {
    return value;
  }
};

const socialProfiles = (siteConfig.socialProfiles || [])
  .map((profile) => absoluteUrl(profile) ?? profile)
  .filter(Boolean);

const personSchema = {
  "@type": "Person",
  "@id": absoluteUrl("#author"),
  "name": siteConfig.author,
  "url": configuredSiteHref || siteHref || undefined,
  "image": absoluteUrl(siteConfig.profileImage),
  "sameAs": socialProfiles.length ? socialProfiles : undefined,
  "jobTitle": siteConfig.jobTitle,
  "worksFor": siteConfig.organization
    ? {
        "@type": "Organization",
        "name": siteConfig.organization,
      }
    : undefined,
};

// Generate appropriate schema based on type
let schema: Record<string, unknown> | undefined;

switch (type) {
  case 'website':
    // WebSite schema - tells Google about your site structure and enables sitelinks search box
    schema = {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": absoluteUrl("#website"),
      "url": configuredSiteHref || siteHref || undefined,
      "name": siteConfig.title,
      "description": siteConfig.description,
      "author": personSchema,
      "potentialAction": configuredSiteHrefNoTrailingSlash
        ? {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": `${configuredSiteHrefNoTrailingSlash}/tags/{search_term_string}/`,
            },
            "query-input": "required name=search_term_string",
          }
        : undefined,
    };
    break;

  case 'article': {
    // Article schema - rich snippets for blog posts
    if (!data || 'items' in data) break; // Skip if it's breadcrumb data
    const articleData = data as StructuredDataContent;
    const articleUrl = articleData.url ? absoluteUrl(articleData.url) : undefined;
    const ogImageFallbackPath = articleData.url
      ? `/og-image${articleData.url.replace(/\/$/, "")}.png`
      : undefined;
    const articleImage = absoluteUrl(articleData.ogImage ?? ogImageFallbackPath);
    schema = {
      "@context": "https://schema.org",
      "@type": "Article",
      ...(articleUrl ? { "@id": `${articleUrl}#article` } : {}),
      "headline": articleData.title,
      "description": articleData.description,
      "datePublished": articleData.publishDate,
      "dateModified": articleData.updatedDate || articleData.publishDate,
      "author": personSchema,
      "publisher": personSchema,
      ...(articleUrl
        ? {
            "mainEntityOfPage": {
              "@type": "WebPage",
              "@id": articleUrl,
            },
          }
        : {}),
      ...(articleImage ? { "image": articleImage } : {}),
      "keywords": articleData.tags?.join(', ')
    };
    break;
  }

  case 'person':
    // Person schema - establishes your identity
    schema = {
      "@context": "https://schema.org",
      ...personSchema,
      "description": "Assistant Professor of Economics at the University of Oxford. Empirical economist and data scientist studying how economies change.",
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "Harvard University"
        }
      ],
      "knowsAbout": [
        "Economics",
        "Industrial Policy",
        "Economic Development",
        "Data Science"
      ]
    };
    break;

  case 'breadcrumb':
    // BreadcrumbList schema - helps Google understand site hierarchy
    if (!data?.items) break;
    schema = {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": data.items.map((item: BreadcrumbItem, index: number) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": absoluteUrl(item.url),
      }))
    };
    break;
}
---

{schema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
