---
interface Props {
  placeholder?: string;
}

const { placeholder = "Search by title or tag…" } = Astro.props;
---

<div id="archive-search" class="relative mb-6b" hidden>
  <label for="post-search" class="sr-only">{placeholder}</label>
  <input
    type="search"
    id="post-search"
    placeholder={placeholder}
    class="w-full px-4b py-2b pr-10b bg-bgColor/50 border border-borderColor rounded-lg"
  />
  <svg
    class="absolute right-3b top-1/2 -translate-y-1/2 w-3b h-3b text-light pointer-events-none"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
    ></path>
  </svg>
  <p id="post-search-status" class="mt-2b text-meta text-light" role="status" aria-live="polite"></p>
</div>

<script>
  const container = document.getElementById("archive-search");
  const searchInput = document.getElementById("post-search") as HTMLInputElement | null;
  const status = document.getElementById("post-search-status");
  const posts = document.querySelectorAll<HTMLElement>("[data-post-item]");
  const yearGroups = document.querySelectorAll<HTMLElement>("[data-year-group]");

  function describeResults(term: string, matchCount: number, rawValue: string): string {
    if (term === "") return "";
    if (matchCount === 0) return `No posts found for "${rawValue}".`;
    return `${matchCount} post${matchCount === 1 ? "" : "s"} found for "${rawValue}".`;
  }

  if (container && searchInput && posts.length > 0) {
    // Only reveal the search field once its handler is actually attached, so a
    // visitor without JavaScript never sees a filter control that can't filter.
    container.hidden = false;

    searchInput.addEventListener("input", () => {
      const term = searchInput.value.trim().toLowerCase();
      const visibleYears = new Set<string>();
      let matchCount = 0;

      posts.forEach((post) => {
        const title = post.dataset.postTitle?.toLowerCase() ?? "";
        const tags = post.dataset.postTags?.toLowerCase() ?? "";
        const year = post.dataset.postYear ?? "";
        const matches = term === "" || title.includes(term) || tags.includes(term);

        post.classList.toggle("hidden", !matches);
        if (matches) {
          matchCount += 1;
          visibleYears.add(year);
        }
      });

      yearGroups.forEach((group) => {
        const year = group.dataset.yearGroup ?? "";
        group.classList.toggle("hidden", !visibleYears.has(year));
      });

      if (status) {
        status.textContent = describeResults(term, matchCount, searchInput.value.trim());
      }
    });
  }
</script>
