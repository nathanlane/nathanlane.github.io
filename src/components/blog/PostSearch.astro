---
interface Props {
  placeholder?: string;
}

const { placeholder = "Search posts..." } = Astro.props;
---

<div class="relative mb-6b">
  <input
    type="search"
    id="post-search"
    placeholder={placeholder}
    class="w-full px-4b py-2b pr-10b bg-bgColor/50 border border-borderColor rounded-lg"
  />
  <svg
    class="absolute right-3b top-1/2 -translate-y-1/2 w-3b h-3b text-light pointer-events-none"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
    ></path>
  </svg>
</div>

<script>
  // Simple client-side search
  const searchInput = document.getElementById('post-search') as HTMLInputElement;
  const posts = document.querySelectorAll('[data-post-item]');
  const yearHeaders = document.querySelectorAll('[data-year-header]');
  
  if (searchInput && posts.length > 0) {
    searchInput.addEventListener('input', (e) => {
      const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
      
      // Track which years have visible posts
      const visibleYears = new Set<string>();
      
      posts.forEach((post) => {
        const title = post.getAttribute('data-post-title')?.toLowerCase() || '';
        const tags = post.getAttribute('data-post-tags')?.toLowerCase() || '';
        const year = post.getAttribute('data-post-year') || '';
        
        if (searchTerm === '' || title.includes(searchTerm) || tags.includes(searchTerm)) {
          post.classList.remove('hidden');
          visibleYears.add(year);
        } else {
          post.classList.add('hidden');
        }
      });
      
      // Hide/show year headers based on whether they have visible posts
      yearHeaders.forEach((header) => {
        const year = header.getAttribute('data-year-header');
        if (year && visibleYears.has(year)) {
          header.classList.remove('hidden');
        } else {
          header.classList.add('hidden');
        }
      });
      
      // Show "no results" message if needed
      const visiblePosts = document.querySelectorAll('[data-post-item]:not(.hidden)');
      const noResultsMsg = document.getElementById('no-results');
      
      if (visiblePosts.length === 0 && searchTerm !== '') {
        if (!noResultsMsg) {
          const msg = document.createElement('div');
          msg.id = 'no-results';
          msg.className = 'text-center text-light py-8b';
          msg.textContent = `No posts found for "${searchTerm}"`;
          searchInput.parentElement?.insertAdjacentElement('afterend', msg);
        } else {
          noResultsMsg.textContent = `No posts found for "${searchTerm}"`;
        }
      } else if (noResultsMsg) {
        noResultsMsg.remove();
      }
    });
  }
</script>