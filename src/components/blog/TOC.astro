---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateToc(headings);
---

<div class="rounded-t-lg">
	<div class="bg-bgColor rounded-t-lg">
		<div class="flex py-1b px-3b items-center title rounded-t-lg bg-color-75 gap-x-2 border-t border-l border-r border-special-light">
			<h2 class="text-xs font-semibold uppercase tracking-wide title">Contents</h2>
			<button
				id="close-toc"
				class="absolute top-1b right-1b btn-icon-close p-1"
				aria-label="Close TOC"
			>
				<Icon aria-hidden="true" class="icon-close size-3" focusable="false" name="lucide:x" />
			</button>
			
		</div>
	</div>
	<div class="bg-bgColor rounded-b-lg">
		<div class="rounded-b-lg pb-2b bg-color-75 border-b border-l border-r border-special-light">
			<div class="px-3b py-1b">
				<ul class="text-xs text-textColor space-y-0.5">
					{toc.map((heading) => <TOCHeading heading={heading} />)}
				</ul>
			</div>
		</div>
	</div>
</div>
