---
import type { CollectionEntry } from "astro:content";
import { getFormattedDate } from "@/utils/date";
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;

const publishDate = post.data.publishDate;
const isoDate = publishDate.toISOString();
const shortDate = getFormattedDate(publishDate, { year: "numeric", month: "short", day: "2-digit" });
const longDate = getFormattedDate(publishDate, { year: "numeric", month: "long", day: "2-digit" });
---

<div class={withDesc ? "flex flex-col" : "flex flex-col grow sm:flex-row sm:items-center sm:justify-between"}>
	{!withDesc ? (
		<>
			<Tag class="font-sans font-normal text-0 text-accent-base md:line-clamp-1 flex-grow">
				<a class="u-hover-underline" data-astro-prefetch href={`/posts/${post.id}/`}>
					{post.data.draft && <span class="text-red-500">(Draft) </span>}
					{post.data.title}
				</a>
			</Tag>
			<time class="shrink-0 text-lightest text--1 ml-4b" datetime={isoDate} title={isoDate}>
				{shortDate}
			</time>
		</>
	) : (
		<>
			<time class="text-body-sm shrink-0 text-lightest" datetime={isoDate} title={isoDate}>
				{longDate}
			</time>
			<Tag class="font-sans font-normal text-0 text-accent-base mt-space-2xs">
				<a class="u-hover-underline" data-astro-prefetch href={`/posts/${post.id}/`}>
					{post.data.title}
				</a>
			</Tag>
			<p class="mt-space-1 line-clamp-2">{post.data.description}</p>
		</>
	)}
</div>
