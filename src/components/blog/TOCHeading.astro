---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, slug, text },
} = Astro.props;
---

<li class="">
	<a
		aria-label={`Scroll to section: ${text}`}
		class="text-light block py-0.5 truncate break-words [padding-left:0.75ch] [text-indent:-0.75ch] before:text-accent-two/60 before:content-['#'] before:text-[10px] hover:text-accent-two transition-colors duration-150"
		href={`#${slug}`}
		title={text}
		>{text}
	</a>
	{!!children.length && (
		<ul class="ml-3 mt-0.5 space-y-0.5 text-[11px]">
			{children.map((subheading) => (
				<Astro.self heading={subheading} />
			))}
		</ul>
	)}
</li>