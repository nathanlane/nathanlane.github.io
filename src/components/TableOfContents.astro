---
export interface Props {
	sections: Array<{
		title: string;
		href: string;
		count?: number;
	}>;
	class?: string;
	headerText?: string;
	showHeader?: boolean;
	showNumbers?: boolean;
}

const { 
	sections, 
	class: className = "", 
	headerText = "Table of Contents",
	showHeader = true,
	showNumbers = true 
} = Astro.props;
---

<nav class={`table-of-contents ${className}`} role="navigation" aria-label="Table of contents">
	{showHeader && (
		<header class="toc-header">
			<h2 class="toc-heading text-small-caps">{headerText}</h2>
		</header>
	)}
	
	<ul class="toc-list" role="list">
		{sections.map((section: { title: string; href: string; count?: number }, index: number) => (
			<li class="toc-entry">
				<a href={section.href} class="toc-link link-nav">
					<span class="toc-title">{section.title}</span>
					<span class="toc-dots" aria-hidden="true"></span>
					{showNumbers && <span class="toc-number">{index + 1}</span>}
				</a>
			</li>
		))}
	</ul>
</nav>

<style>
	/* Container styling - minimal, document-centric */
	.table-of-contents {
		/* No background or border - let typography breathe */
		margin-bottom: var(--space-12); /* 72px - 3 baseline units */
	}

	/* Header section */
	.toc-header {
		margin-bottom: var(--space-3); /* 36px - 1.5 baseline units */
		padding-bottom: var(--space-1); /* 12px - 0.5 baseline units */
	}

	/* Small caps title styling matching home page sections */
	.toc-heading {
		font-family: var(--font-sans);
		font-size: var(--step-1); /* 12.8-14.4px - matching section-link */
		font-weight: 500;
		color: var(--theme-color-600);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin: 0;
		line-height: var(--baseline); /* 24px - align to baseline */
	}

	/* Remove default list styling */
	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	/* Entry spacing aligned to baseline grid */
	.toc-entry {
		margin: 0;
		padding: 0;
		line-height: var(--baseline); /* 24px baseline */
	}

	.toc-entry + .toc-entry {
		margin-top: var(--space-1); /* 6px - 0.25 baseline units for tight spacing */
	}

	/* Link container with flex layout for dot leaders */
	.toc-link {
		display: flex;
		align-items: baseline;
		/* Let link-nav handle text-decoration and transitions */
		
		/* Typography */
		font-size: var(--step-0); /* 15.6-17px */
		line-height: var(--baseline); /* 24px - baseline aligned */
	}

	/* Sequential numbering */
	.toc-number {
		font-family: var(--font-sans);
		font-size: var(--step-0);
		font-variant-numeric: lining-nums tabular-nums;
		color: var(--theme-color-500);
		margin-left: var(--space-2); /* 12px */
		flex: 0 0 auto;
	}

	/* Title styling - serif with academic feel */
	.toc-title {
		/* Let link-nav handle font properties */
		line-height: var(--baseline);
		
		/* Prevent wrapping */
		flex: 0 0 auto;
		white-space: nowrap;
		
		/* Spacing from dots */
		margin-right: var(--space-2); /* 12px */
	}

	/* Dot leaders for visual rhythm */
	.toc-dots {
		/* Flex fill the space */
		flex: 1 1 auto;
		
		/* Option 1: Traditional dots (available but unused) */
		
		/* Option 2: Solid hairline (current) */
		border-bottom: 1px solid var(--theme-color-300);
		
		/* Align with baseline */
		height: 0;
		align-self: center;
		margin: 0 var(--space-2); /* 12px spacing */
	}

	/* Hover states - subtle and refined */
	/* link-nav handles color changes, we just need dots and number */
	
	.toc-link:hover .toc-number {
		color: var(--theme-color-600);
	}

	.toc-link:hover .toc-dots {
		border-bottom-color: var(--theme-accent-base);
	}

	/* Focus states - using site's consolidated system */
	.toc-link:focus-visible {
		outline: 2px solid var(--theme-accent);
		outline-offset: 2px;
		border-radius: 2px;
	}

	/* Dark mode adaptations */
	:global([data-theme="dark"]) .toc-header {
		border-bottom-color: var(--theme-color-800);
	}

	:global([data-theme="dark"]) .toc-heading {
		color: var(--theme-color-300);
	}

	:global([data-theme="dark"]) .toc-number {
		color: var(--theme-color-500);
	}

	:global([data-theme="dark"]) .toc-dots {
		border-bottom-color: var(--theme-color-800);
	}

	:global([data-theme="dark"]) .toc-link:hover .toc-dots {
		border-bottom-color: var(--theme-accent-light);
	}

	:global([data-theme="dark"]) .toc-link:hover .toc-number {
		color: var(--theme-color-400);
	}

	/* High contrast mode support */
	@media (prefers-contrast: high) {
		.toc-dots {
			border-bottom-width: 2px;
			border-bottom-style: dotted;
		}
	}

	/* Print optimization */
	@media print {
		.table-of-contents {
			break-inside: avoid;
		}
		
		.toc-heading {
			font-weight: 600;
		}
		
		.toc-dots {
			border-bottom: 1px dotted var(--theme-text) !important;
		}
		
		/* Print link styles handled by consolidated system */
	}

	/* Responsive adjustments */
	@media (max-width: 640px) {
		.toc-entry + .toc-entry {
			margin-top: 0; /* Remove spacing on mobile for compactness */
		}
		
		.toc-link {
			font-size: var(--step--1); /* Slightly smaller on mobile */
		}
	}
</style> 