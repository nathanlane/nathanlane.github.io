---
import { normalizeStatus } from '@/utils/date';
import MetadataLine from './MetadataLine.astro';

interface Props {
  title: string;
  href: string;
  type: 'research' | 'writing' | 'project' | 'post';
  date?: string;
  status?: 'published' | 'working-paper' | 'work-in-progress' | 'archived';
  description: string;
  metadata?: string;
  // Research-specific props
  publication?: string;
  download?: string;
  link?: string;
}

const { 
  title, 
  href, 
  type, 
  date, 
  status, 
  description, 
  metadata,
  publication,
  download,
  link
} = Astro.props;

// Format date if provided
const formattedDate = date ? new Date(date).toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'short' 
}) : '';

// Build metadata items using simplified light system
const metadataItems = [
  { text: type.toUpperCase() },
  ...(formattedDate ? [{ text: formattedDate }] : []),
  ...(status ? [{ text: normalizeStatus(status) }] : []),
  ...(metadata ? [{ text: metadata }] : [])
].filter(Boolean);
---

<article class="document-entry">
  <h3 class="heading-3">
    <a href={href} class="link-title">{title}</a>
  </h3>
  
  <MetadataLine 
    items={metadataItems}
    class="mb-3b"
  />
  
  <!-- Publication information if available -->
  {publication && (
    <div class="text-meta text-accent-base font-medium mb-2b">
      {publication}
    </div>
  )}
  
  <p class="text-body">{description}</p>
  
  <!-- Research links if available -->
  {(download || link) && (
    <div class="flex items-center gap-4b text-meta pt-2b">
      {download && (
        <a href={download} class="link-nav text-meta" target="_blank" rel="noopener">
          PDF ↗
        </a>
      )}
      {link && (
        <a href={link} class="link-nav text-meta" target="_blank" rel="noopener">
          Journal ↗
        </a>
      )}
    </div>
  )}
</article>

<style>
  .document-entry {
    margin-bottom: var(--space-8); /* 48px - generous separation */
  }
  
  /* All link styling handled by global link classes */
</style> 
