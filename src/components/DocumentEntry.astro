---
interface Props {
  title: string;
  href: string;
  type: 'research' | 'writing' | 'project' | 'post';
  date?: string;
  status?: 'published' | 'working-paper' | 'in-progress';
  description: string;
  metadata?: string;
}

const { title, href, type, date, status, description, metadata } = Astro.props;

// Format date if provided
const formattedDate = date ? new Date(date).toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'short' 
}) : '';

// Build metadata string
const metadataParts = [
  type.toUpperCase(),
  formattedDate,
  status?.toUpperCase(),
  metadata
].filter(Boolean);
---

<article class="document-entry">
  <h3 class="entry-title">
    <a href={href} class="feature-link">{title}</a>
  </h3>
  
  <div class="entry-metadata">
    {metadataParts.join(' • ')}
  </div>
  
  <p class="entry-description">{description}</p>
</article>

<style>
  .document-entry {
    margin-bottom: var(--space-8); /* 48px - generous separation */
  }

  .entry-title {
    font-family: var(--font-newsreader);
    font-size: var(--step-1); /* 18.8-21.3px */
    font-weight: 400;
    letter-spacing: -0.015em;
    margin-bottom: var(--space-1); /* 6px - tight coupling */
    line-height: 1.3;
  }

  .entry-metadata {
    font-family: var(--font-sans);
    font-size: var(--step--1); /* 12.8-14.4px */
    font-variant: small-caps;
    letter-spacing: 0.075em;
    color: var(--theme-color-600);
    margin-bottom: var(--space-2); /* 12px */
    font-weight: 500;
  }

  .entry-description {
    font-size: var(--step-0); /* 15.6-17px */
    line-height: 1.6;
    color: var(--theme-text);
    margin-bottom: 0;
  }

  /* Dark mode adjustments */
  :global([data-theme="dark"]) .entry-metadata {
    color: var(--theme-color-400);
  }
</style> 