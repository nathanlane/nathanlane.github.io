---
import OptimizedImage from '@/components/OptimizedImage.astro';
import { renderMarkdown, renderMarkdownInline } from '@/utils/markdown';

export interface Props {
  bio: {
    title?: string | undefined;
    tagline?: string | undefined;
    narrative: string;
    currently?: string[] | undefined;
    affiliations?: Array<{
      title: string;
      role: string;
    }> | undefined;
    photo?: {
      src: string;
      alt: string;
      caption?: string | undefined;
      display: boolean;
    } | undefined;
  };
  class?: string;
}

const { bio, class: className = '' } = Astro.props;

// Parse markdown in narrative
const narrativeHtml = await renderMarkdown(bio.narrative);
const photoCaptionHtml =
	bio.photo?.caption !== undefined ? await renderMarkdownInline(bio.photo.caption) : undefined;
---

<section class={`bio-panel ${className}`} data-content-type="long-form">
  <div class="max-w-4xl mx-auto">
    <!-- Header with customizable title -->
    <header class="mb-8b">
      <h1 class="heading-1 text-accent-base mb-3b">{bio.title || "About"}</h1>
      {bio.tagline && (
        <p class="text-2 text-light font-body leading-relaxed">
          {bio.tagline}
        </p>
      )}
    </header>

    <!-- Main content area -->
    <div class="grid gap-8b">
      <!-- Photo (optional - only displays if photo config exists, has src, and display is true) -->
      {bio.photo?.display && bio.photo?.src && (
        <aside class="photo-container">
          <figure class="relative">
            <OptimizedImage
              src={bio.photo.src}
              alt={bio.photo.alt || "Profile photo"}
              class="rounded-lg"
              widths={[400, 600]}
              sizes="(max-width: 768px) 100vw, 400px"
            />
            {photoCaptionHtml && (
              <figcaption class="text--2 text-lightest mt-2b">
                <Fragment set:html={photoCaptionHtml} />
              </figcaption>
            )}
          </figure>
        </aside>
      )}

      <!-- Narrative -->
      <div class="narrative prose prose-lane max-w-none">
        <Fragment set:html={narrativeHtml} />
      </div>

      <!-- Currently section -->
      {bio.currently && bio.currently.length > 0 && (
        <div class="currently-section">
          <h3 class="text-1 font-medium text-accent-base mb-4b">Currently</h3>
          <ul class="space-y-3b">
            {bio.currently.map((item) => (
              <li class="flex items-start gap-2b text-0">
                <span class="text-accent-two mt-0.5" aria-hidden="true">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Affiliations - Disabled -->
      {/* 
      {bio.affiliations && bio.affiliations.length > 0 && (
        <footer class="affiliations border-t border-special pt-6b mt-8b">
          <div class="flex flex-wrap gap-4b text-0 text-light">
            {bio.affiliations.map((affiliation, index) => (
              <>
                <div class="flex items-center gap-1b">
                  <span class="font-medium">{affiliation.title}</span>
                  <span class="text-lightest">·</span>
                  <span>{affiliation.role}</span>
                </div>
                {index < bio.affiliations!.length - 1 && (
                  <span class="text-lightest hidden sm:block" aria-hidden="true">|</span>
                )}
              </>
            ))}
          </div>
        </footer>
      )}
      */}
    </div>
  </div>
</section>

<style>
  .bio-panel {
    /* Elegant spacing and typography */
    --prose-p-spacing: var(--space-4);
  }

  /* Custom typography for narrative - larger font size */
  .narrative :global(p) {
    @apply text-1 leading-relaxed mb-6b;
  }

  .narrative :global(p:last-child) {
    @apply mb-0;
  }

  /* Apply editorial link style to all narrative links by default */
  .narrative a {
    color: var(--link-color-editorial, var(--theme-accent-base));
    font-weight: 450;
    text-decoration: underline;
    text-decoration-color: var(--link-color-editorial, var(--theme-accent-base));
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.2em;
  }
  
  .narrative a:hover {
    color: var(--link-color-hover);
    text-decoration-color: var(--link-color-hover);
    text-decoration-thickness: 0.075em;
  }

  /* Currently list styling */
  .currently-section ul {
    padding: 0;
    list-style: none;
  }

  /* Photo styling for desktop layout */
  @media (min-width: 768px) {
    .bio-panel .grid {
      grid-template-columns: 1fr;
    }
    
    /* If photo is present, use 2-column layout */
    .photo-container + .narrative {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  /* Subtle hover effects - transitions removed */

  /* Print styles */
  @media print {
    .photo-container {
      display: none;
    }
  }
</style> 
