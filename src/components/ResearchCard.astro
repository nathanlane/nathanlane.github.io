---
export interface Props {
	title: string;
	authors: string;
	year: string;
	description: string;
	publication?: string;
	url?: string;
	download?: string;
	link?: string;
	featured?: boolean;
}

const { title, authors, year, description, publication, url, download, link, featured = false } = Astro.props;
---

<article class={`${featured ? 'pl-3b border-l-2 border-accent-base' : ''}`}>
	
	<div class="space-y-2b">
		
		<!-- Title with semantic typography -->
		{url ? (
			<h3 class="heading-4 mb-1b">
				<a href={url} class="feature-link">
					{title}
				</a>
			</h3>
		) : (
			<h3 class="heading-4 mb-1b">
				{title}
			</h3>
		)}
		
		<!-- Metadata line with proper styling -->
		<div class="text-meta text-light">
			{authors} • {year}
		</div>
		
		<!-- Publication with accent color -->
		{publication && (
			<div class="text-meta text-accent-base font-medium">
				{publication}
			</div>
		)}
		
		<!-- Description with optimal reading typography -->
		<p class="text-0 text-light leading-relaxed max-w-prose">
			{description}
		</p>
		
		<!-- Links with consistent styling -->
		{(url || download || link) && (
			<div class="flex items-center justify-between text-meta pt-2b">
				{url && (
					<a href={url} class="nav-link text-meta uppercase tracking-wide">
						View details →
					</a>
				)}
				{(download || link) && (
					<div class="flex gap-4b">
						{download && (
							<a href={download} class="nav-link text-meta" target="_blank" rel="noopener">
								PDF ↗
							</a>
						)}
						{link && (
							<a href={link} class="nav-link text-meta" target="_blank" rel="noopener">
								Journal ↗
							</a>
						)}
					</div>
				)}
			</div>
		)}
		
	</div>
</article>

<style>
	/* Feature link styling for titles */
	.feature-link {
		color: var(--theme-text);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	
	.feature-link:hover {
		color: var(--theme-accent-base);
	}
	
	/* Navigation link styling */
	.nav-link {
		color: var(--theme-color-600);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.2s ease;
	}
	
	.nav-link:hover {
		color: var(--theme-text);
	}
	
	/* External link indicator */
	a[target="_blank"]::after {
		content: "";
		display: inline-block;
		margin-left: 0.1em;
	}
</style>