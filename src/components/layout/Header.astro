---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";
import { Icon } from "astro-icon/components";

// Header configuration from siteConfig
const header = {
	logo: {
		show: siteConfig.showLogo ?? false,
		text: siteConfig.title,
		href: "/",
	},
	title: {
		show: siteConfig.showTitle ?? false,
		text: siteConfig.title,
	},
	// Convert menuLinks (path/title) to primary format (href/title)
	primary: menuLinks.map((link) => ({ href: link.path, title: link.title })),
};
---

<header id="main-header" class="header relative top-0 left-0 z-20 w-full bg-bgColor">
	<div
		class="header-content mx-auto flex h-full w-full max-w-5xl items-center justify-between px-space-s"
	>
		<!-- Left side: Logo (if shown) -->
		{
			header.logo.show && (
				<div class="flex items-center flex-shrink-0 mr-8b">
					<a
						aria-label={header.logo.text}
						aria-current={Astro.url.pathname === "/" ? "page" : false}
						class="logo-link group flex-nowrap items-center gap-2b hover:filter-none sm:relative"
						href={header.logo.href}
					>
						<!-- Logo Image -->
						<img
							src="/logo.svg"
							alt=""
							class="logo-image h-6b w-auto flex-shrink-0 max-w-[120px]"
							aria-hidden="true"
						/>
						<!-- Optional: Site title next to logo (can be removed if you want logo only) -->
						<span class="site-title font-heading font-light whitespace-nowrap flex-shrink-0">{header.logo.text}</span>
					</a>
				</div>
			)
		}

		<!-- If no logo, add spacer div to maintain layout -->
		{!header.logo.show && <div />}

		<!-- Right side: Navigation and Actions -->
		<div class="flex items-center gap-space-xs ml-auto pl-12b">
			<nav
				aria-label="Main navigation"
				class="nav-desktop hidden md:flex items-center gap-space-s"
				data-context="navigation"
			>
				{
					header.primary.map((link) => (
						<a
							aria-current={Astro.url.pathname === link.href ? "page" : false}
							class="link-nav text--2"
							data-astro-prefetch={!link.href.startsWith("mailto:") ? true : undefined}
							href={link.href}
						>
							{link.title}
						</a>
					))
				}
			</nav>

			<div class="nav-actions flex items-center gap-space-xs">
				<ThemeToggle />

				<!-- Mobile menu toggle -->
				<button
					aria-expanded="false"
					aria-haspopup="menu"
					aria-label="Open navigation menu"
					class="mobile-menu-toggle md:hidden"
					id="toggle-nav-menu-mobile"
					type="button"
				>
					<Icon
						id="open-nav-menu-icon"
						aria-hidden="true"
						class="absolute start-1/2 top-1/2 icon-nav -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100"
						focusable="false"
						name="lucide:menu"
					/>
					<Icon
						id="close-nav-menu-icon"
						aria-hidden="true"
						class="absolute start-1/2 top-1/2 icon-nav -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0"
						focusable="false"
						name="lucide:x"
					/>
				</button>
			</div>
		</div>
	</div>
</header>

<!-- Mobile drawer menu -->
<div id="drawer" class="fixed inset-0 z-10 hidden" aria-hidden="true">
	<div id="drawer-body" class="absolute inset-0 -translate-y-full transform bg-bgColor">
		<nav
			aria-label="Mobile navigation menu"
			class="absolute inset-0 flex flex-col items-center justify-center gap-y-space-s text-center"
			id="nav-menu-mobile"
		>
			{
				header.primary.map((link) => (
					<a
						aria-current={Astro.url.pathname === link.href ? "page" : false}
						class="link-nav text-1"
						data-astro-prefetch={!link.href.startsWith("mailto:") ? true : undefined}
						href={link.href}
					>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
</div>

<style>
	/* Header styles */
	.header {
		--header-height: 72px;
		height: var(--header-height);
	}

	/* Logo image */
	.logo-image {
		/* Baseline grid aligned: h-6b = 36px */
		height: var(--space-6); /* 36px - good size for header logos */
		width: auto;
		display: block;
		transition: opacity 200ms ease;
	}

	.logo-image:hover {
		opacity: 0.8;
	}

	/* Dark mode logo adjustments (if needed for visibility) */
	:global(.dark) .logo-image {
		/* Uncomment if you need to invert logo colors in dark mode */
		/* filter: invert(1); */
	}

	/* Force flex display on logo link (override default inline) */
	.logo-link {
		display: flex !important;
	}

	/* Site title - using nav link behavior but darker default */
	.site-title {
		color: var(--theme-text);
		transition: color 200ms ease;
	}

	.site-title:hover {
		color: var(--theme-accent-base);
	}

		/* Navigation link styles - let link-nav handle the base behaviors */
		/* link-nav already handles aria-current="page" styling */

	/* Mobile menu toggle */
	.mobile-menu-toggle {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--space-l);
		height: var(--space-l);
		padding: 0;
		background: transparent;
		border: none;
		color: var(--color-text);
		cursor: pointer;
	}

	.mobile-menu-toggle:hover {
		color: var(--color-text-muted);
	}

	.icon-nav {
		width: 24px;
		height: 24px;
	}

	/* Mobile drawer styles */
	#drawer {
		background-color: var(--theme-bg);
	}

	#drawer-body {
		height: 100vh;
		overflow-y: auto;
	}

	.mobile-nav-section {
		margin-bottom: var(--space-m);
	}

	.mobile-nav-heading {
		font-size: var(--text--1);
		font-weight: 500;
		color: var(--color-text-muted);
		margin-bottom: var(--space-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em; /* matches .tracking-nav utility */
	}

	.mobile-nav-items {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}
</style>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const toggleNavMenuMobileButton = document.getElementById("toggle-nav-menu-mobile");
		const openMenuIcon = document.getElementById("open-nav-menu-icon");
		const closeMenuIcon = document.getElementById("close-nav-menu-icon");
		const drawer = document.getElementById("drawer");

		// Check if elements exist
		if (!toggleNavMenuMobileButton || !openMenuIcon || !closeMenuIcon || !drawer) {
			return;
		}

		const drawerBody = document.getElementById("drawer-body");
		if (!drawerBody) {
			return;
		}

		toggleNavMenuMobileButton.addEventListener("click", () => {
			const isOpen = toggleNavMenuMobileButton.getAttribute("aria-expanded") === "true";

			if (isOpen) {
				// Close menu
				drawer.classList.add("hidden");
				drawer.classList.remove("open");
				drawerBody.classList.add("-translate-y-full");
				drawerBody.classList.remove("translate-y-0");

				// Switch icons
				openMenuIcon.classList.remove("scale-0", "opacity-0");
				closeMenuIcon.classList.add("scale-0", "opacity-0");
			} else {
				// Show menu
				drawer.classList.remove("hidden");
				drawer.classList.add("open");
				drawerBody.classList.add("translate-y-0");
				drawerBody.classList.remove("-translate-y-full");

				// Switch icons
				openMenuIcon.classList.add("scale-0", "opacity-0");
				closeMenuIcon.classList.remove("scale-0", "opacity-0");
			}

			// Update button state
			toggleNavMenuMobileButton.setAttribute("aria-expanded", (!isOpen).toString());
		});

		// Close drawer when clicking on a link
		const mobileNavLinks = document.querySelectorAll("#nav-menu-mobile a");
		mobileNavLinks.forEach((link) => {
			link.addEventListener("click", () => {
				// Close the drawer
				if (toggleNavMenuMobileButton && drawerBody && drawer) {
					drawer.classList.add("hidden");
					drawer.classList.remove("open");
					drawerBody.classList.add("-translate-y-full");
					drawerBody.classList.remove("translate-y-0");

					// Reset icons
					if (openMenuIcon && closeMenuIcon) {
						openMenuIcon.classList.remove("scale-0", "opacity-0");
						closeMenuIcon.classList.add("scale-0", "opacity-0");
					}

					toggleNavMenuMobileButton.setAttribute("aria-expanded", "false");
				}
			});
		});
	});
</script>
