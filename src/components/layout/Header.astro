---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";
import { Icon } from "astro-icon/components";

// Header configuration from siteConfig
const header = {
	logo: {
		show: siteConfig.showLogo ?? false,
		text: siteConfig.title,
		href: "/",
	},
	title: {
		show: siteConfig.showTitle ?? false,
		text: siteConfig.title,
	},
	// Convert menuLinks (path/title) to primary format (href/title)
	primary: menuLinks.map((link) => ({ href: link.path, title: link.title })),
};
---

<header id="main-header" class="header relative top-0 left-0 z-20 w-full bg-bgColor">
	<div
		class="header-content mx-auto flex h-full w-full max-w-5xl items-center justify-between px-space-s"
	>
		<!-- Left side: Logo (if shown) -->
		{
			header.logo.show && (
				<div class="flex items-center flex-shrink-0 mr-8b">
					<a
						aria-label={header.logo.text}
						aria-current={Astro.url.pathname === "/" ? "page" : false}
						class="logo-link group flex-nowrap items-center gap-2b hover:filter-none sm:relative"
						href={header.logo.href}
					>
						<!-- Logo Image -->
						<img
							src="/logo.svg"
							alt=""
							class="logo-image h-6b w-auto flex-shrink-0 max-w-[120px]"
							aria-hidden="true"
						/>
						<!-- Optional: Site title next to logo (can be removed if you want logo only) -->
						<span class="site-title font-heading font-light whitespace-nowrap flex-shrink-0">{header.logo.text}</span>
					</a>
				</div>
			)
		}

		<!-- If no logo, add spacer div to maintain layout -->
		{!header.logo.show && <div />}

		<!-- Right side: Navigation and Actions -->
		<div class="flex items-center gap-space-xs ml-auto pl-12b">
			<nav
				aria-label="Main navigation"
				class="nav-desktop hidden md:flex items-center gap-space-s"
				data-context="navigation"
			>
				{
					header.primary.map((link) => (
						<a
							aria-current={Astro.url.pathname === link.href ? "page" : false}
							class="link-nav text--2"
							data-astro-prefetch={!link.href.startsWith("mailto:") ? true : undefined}
							href={link.href}
						>
							{link.title}
						</a>
					))
				}
			</nav>

			<div class="nav-actions flex items-center gap-space-xs">
				<ThemeToggle />

				<!-- Mobile menu toggle -->
				<button
					aria-expanded="false"
					aria-controls="drawer"
					aria-label="Open navigation menu"
					class="mobile-menu-toggle md:hidden"
					id="toggle-nav-menu-mobile"
					type="button"
				>
					<Icon
						id="open-nav-menu-icon"
						aria-hidden="true"
						class="absolute start-1/2 top-1/2 icon-nav -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100"
						focusable="false"
						name="lucide:menu"
					/>
					<Icon
						id="close-nav-menu-icon"
						aria-hidden="true"
						class="absolute start-1/2 top-1/2 icon-nav -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0"
						focusable="false"
						name="lucide:x"
					/>
				</button>
			</div>
		</div>
	</div>
</header>

<!-- Mobile drawer menu -->
<div id="drawer" class="fixed inset-0 z-10 hidden" aria-hidden="true">
	<div id="drawer-body" class="absolute inset-0 -translate-y-full transform bg-bgColor">
		<nav
			aria-label="Mobile navigation menu"
			class="absolute inset-0 flex flex-col items-center justify-center gap-y-space-s text-center"
			id="nav-menu-mobile"
		>
			{
				header.primary.map((link) => (
					<a
						aria-current={Astro.url.pathname === link.href ? "page" : false}
						class="link-nav text-1"
						data-astro-prefetch={!link.href.startsWith("mailto:") ? true : undefined}
						href={link.href}
					>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
</div>

<style>
	/* Header styles */
	.header {
		--header-height: 72px;
		height: var(--header-height);
	}

	/* Logo image */
	.logo-image {
		/* Baseline grid aligned: h-6b = 36px */
		height: var(--space-6); /* 36px - good size for header logos */
		width: auto;
		display: block;
		transition: opacity 200ms ease;
	}

	.logo-image:hover {
		opacity: 0.8;
	}

	/* Dark mode logo adjustments (if needed for visibility) */
	:global(.dark) .logo-image {
		/* Uncomment if you need to invert logo colors in dark mode */
		/* filter: invert(1); */
	}

	/* Force flex display on logo link (override default inline) */
	.logo-link {
		display: flex !important;
	}

	/* Site title - using nav link behavior but darker default */
	.site-title {
		color: var(--theme-text);
		transition: color 200ms ease;
	}

	.site-title:hover {
		color: var(--theme-accent-base);
	}

		/* Navigation link styles - let link-nav handle the base behaviors */
		/* link-nav already handles aria-current="page" styling */

	/* Mobile menu toggle */
	/* Box, layout and reset live in the global .mobile-menu-toggle rule (global.css,
	   @layer components) which sizes this control at 40px. This block previously
	   duplicated all of that but sized it with an undefined --space-l, so its width
	   and height were invalid at computed-value time and fell back to `auto` --
	   collapsing the button to zero width, since both icons are absolutely
	   positioned and contribute no in-flow size. Only the additions remain here. */
	.mobile-menu-toggle {
		padding: 0;
		color: var(--theme-text);
	}

	.mobile-menu-toggle:hover {
		color: var(--theme-color-600);
	}

	.icon-nav {
		width: 24px;
		height: 24px;
	}

	/* Mobile drawer styles */
	#drawer {
		background-color: var(--theme-bg);
	}

	#drawer-body {
		height: 100vh;
		overflow-y: auto;
	}

	.mobile-nav-section {
		margin-bottom: var(--space-m);
	}

	.mobile-nav-heading {
		font-size: var(--step--1);
		font-weight: 500;
		color: var(--theme-color-600);
		margin-bottom: var(--space-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em; /* matches .tracking-nav utility */
	}

	.mobile-nav-items {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}
</style>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const toggleNavMenuMobileButton = document.getElementById("toggle-nav-menu-mobile");
		const openMenuIcon = document.getElementById("open-nav-menu-icon");
		const closeMenuIcon = document.getElementById("close-nav-menu-icon");
		const drawer = document.getElementById("drawer");

		// Check if elements exist
		if (!toggleNavMenuMobileButton || !openMenuIcon || !closeMenuIcon || !drawer) {
			return;
		}

		const drawerBody = document.getElementById("drawer-body");
		if (!drawerBody) {
			return;
		}

		// The drawer is a hidden overlay until opened. `aria-hidden` has to track that:
		// while it said "true" with the drawer open, its links stayed focusable inside a
		// subtree hidden from assistive technology (axe: aria-hidden-focus, WCAG 4.1.2).
		const setDrawerOpen = (open: boolean): void => {
			drawer.classList.toggle("hidden", !open);
			drawer.classList.toggle("open", open);
			drawer.setAttribute("aria-hidden", String(!open));

			drawerBody.classList.toggle("-translate-y-full", !open);
			drawerBody.classList.toggle("translate-y-0", open);

			openMenuIcon.classList.toggle("scale-0", open);
			openMenuIcon.classList.toggle("opacity-0", open);
			closeMenuIcon.classList.toggle("scale-0", !open);
			closeMenuIcon.classList.toggle("opacity-0", !open);

			toggleNavMenuMobileButton.setAttribute("aria-expanded", String(open));
			toggleNavMenuMobileButton.setAttribute(
				"aria-label",
				open ? "Close navigation menu" : "Open navigation menu",
			);
		};

		const isDrawerOpen = (): boolean =>
			toggleNavMenuMobileButton.getAttribute("aria-expanded") === "true";

		const closeDrawer = (returnFocus: boolean): void => {
			setDrawerOpen(false);
			if (returnFocus) {
				toggleNavMenuMobileButton.focus();
			}
		};

		toggleNavMenuMobileButton.addEventListener("click", () => {
			const open = !isDrawerOpen();
			setDrawerOpen(open);

			// Move focus into the drawer so keyboard users land on the navigation they
			// just opened rather than continuing from the toggle button.
			if (open) {
				const firstLink = drawer.querySelector<HTMLAnchorElement>("#nav-menu-mobile a");
				firstLink?.focus();
			}
		});

		// Escape closes the drawer and returns focus to the control that opened it.
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && isDrawerOpen()) {
				closeDrawer(true);
			}
		});

		// Close drawer when clicking on a link (focus follows the navigation itself).
		const mobileNavLinks = document.querySelectorAll("#nav-menu-mobile a");
		mobileNavLinks.forEach((link) => {
			link.addEventListener("click", () => closeDrawer(false));
		});

		// Publish the initial closed state.
		setDrawerOpen(false);
	});
</script>
