<theme-toggle class="theme-select-wrap">
	<label class="sr-only" for="theme-preference">Theme</label>
	<select class="theme-select text--2" id="theme-preference" name="theme-preference">
		<option value="system">System</option>
		<option value="light">Light</option>
		<option value="dark">Dark</option>
	</select>
</theme-toggle>

<style>
	.theme-select-wrap {
		display: inline-flex;
	}

	.theme-select {
		height: 36px;
		padding: 0 var(--space-2xs, 0.5rem);
		border: 1px solid var(--theme-special-light);
		border-radius: 8px;
		background: transparent;
		color: var(--theme-text);
		cursor: pointer;
	}

	.theme-select:hover {
		background: var(--theme-special-lighter);
	}
</style>

<script>
	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			const select = this.querySelector<HTMLSelectElement>("select")!;

			select.value = document.documentElement.getAttribute("data-theme-preference") || "system";

			select.addEventListener("change", () => {
				document.dispatchEvent(
					new CustomEvent("theme-change", { detail: { preference: select.value } }),
				);
			});

			document.addEventListener("theme-applied", ((e: CustomEvent) => {
				if (select.value !== e.detail.preference) select.value = e.detail.preference;
			}) as EventListener);
		}
	}

	customElements.define("theme-toggle", ThemeToggle);
</script>
