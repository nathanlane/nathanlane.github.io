---
import { Icon } from "astro-icon/components";
import FormattedDate from "@/components/FormattedDate.astro";

export interface Props {
  title: string;
  description: string;
  mediaType: "interview" | "podcast" | "video" | "article" | "press" | "talk" | "panel";
  outlet: string;
  date: Date;
  link: string;
  hasTranscript?: boolean;
  class?: string;
}

const { 
  title, 
  description, 
  mediaType, 
  outlet, 
  date, 
  link, 
  hasTranscript = false,
  class: className = "" 
} = Astro.props;

// Icon mapping for media types
const mediaIcons = {
  interview: "lucide:mic",
  podcast: "lucide:headphones",
  video: "lucide:play-circle",
  article: "lucide:newspaper",
  press: "lucide:megaphone",
  talk: "lucide:presentation",
  panel: "lucide:users"
};

const icon = mediaIcons[mediaType] || "lucide:external-link";
---

<article class={`media-card ${className}`}>
  <div class="media-icon">
    <Icon 
      name={icon} 
      class="w-5 h-5 text-accent-base"
      aria-hidden="true"
    />
  </div>
  
  <div class="media-content">
    <div class="media-meta">
      <span class="media-outlet">{outlet}</span>
      <span class="media-separator">•</span>
      <FormattedDate 
        date={date} 
        class="media-date"
        dateTimeOptions={{ year: "numeric", month: "short", day: "numeric" }}
      />
    </div>
    
    <h3 class="media-title">
      <a 
        href={link} 
        target="_blank" 
        rel="noopener noreferrer"
        class="media-link"
      >
        {title}
        <Icon 
          name="lucide:arrow-up-right" 
          class="inline-block w-2b h-2b ml-1b opacity-60"
          aria-hidden="true"
        />
      </a>
    </h3>
    
    <p class="media-description">{description}</p>
    
    {hasTranscript && (
      <span class="media-transcript">
        <Icon name="lucide:file-text" class="inline-block w-2b h-2b mr-1b" />
        Transcript available
      </span>
    )}
  </div>
</article>

<style>
  .media-card {
    @apply flex gap-4b py-4b;
    @apply border-b border-color-100 last:border-0;
  }
  
  .media-icon {
    @apply flex-shrink-0 w-10b h-10b;
    @apply flex items-center justify-center;
    @apply bg-color-100 rounded-md;
  }
  
  .media-content {
    @apply flex-grow space-y-1b;
  }
  
  .media-meta {
    @apply flex items-center gap-2b text-xs text-light;
  }
  
  .media-outlet {
    @apply font-medium;
    font-variation-settings: 'wght' 500;
    letter-spacing: 0.01em;
  }
  
  .media-separator {
    @apply opacity-50;
  }
  
  .media-title {
    @apply text-base font-medium;
    @apply leading-snug;
  }
  
  .media-link {
    @apply text-accent-base hover:text-accent;
    @apply underline decoration-1 hover:decoration-2;
    font-variation-settings: 'wght' 450;
  }
  
  .media-link:hover {
    font-variation-settings: 'wght' 500;
  }
  
  .media-description {
    @apply text-sm text-textColor;
    @apply leading-relaxed;
  }
  
  .media-transcript {
    @apply inline-flex items-center;
    @apply text-xs text-light;
    @apply mt-2b;
  }
  
  /* Dark mode adjustments */
  :root[data-theme="dark"] .media-icon {
    @apply bg-color-200;
  }
</style>