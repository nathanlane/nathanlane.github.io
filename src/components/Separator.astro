---
export interface Props {
	type?: "horizontal" | "vertical" | "dot";
	className?: string;
}

const { type = "horizontal", className = "" } = Astro.props as Props;

// Classes for separators depending on type
const separatorClasses = {
	base: "flex-shrink-0 bg-lighter mx-space-2xs", // Common styles
	types: {
		horizontal: "h-px w-full", // Horizontal separator
		vertical: "h-full w-px", // Vertical separator
		dot: "w-space-1 h-space-1 rounded-full", // Circle for dot
	} as const, // Specify that types here are concrete strings
};

const typeClass = separatorClasses.types[type];
---

{
	type === "dot" ? (
		<span class={`${separatorClasses.base} ${typeClass} ${className}`} />
	) : (
		<span
			role="separator"
			aria-orientation={type === "horizontal" ? "horizontal" : "vertical"}
			class={`${separatorClasses.base} ${typeClass} ${className}`}
		/>
	)
}
