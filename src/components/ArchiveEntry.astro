---
/*
# ArchiveEntry Component

A reusable typographic component for displaying archive entries across different content types.
Generalizes the excellent Media page design patterns for writing, research, projects, etc.
Follows classical typography principles from Bringhurst, Ruder, Butterick, and Hochuli.

## Usage Examples:

### Writing Archive
```astro
<ArchiveEntry 
  title="The Future of Typography"
  primaryMeta="Essay"
  secondaryMeta="March 2024"
  tertiaryMeta="Design Systems"
  link="/writing/future-typography"
  description="Exploring how digital typography continues to evolve..."
/>
```

### Research Archive  
```astro
<ArchiveEntry 
  title="Industrial Policy in East Asia"
  primaryMeta="Research Paper"
  secondaryMeta="January 2024"
  tertiaryMeta="Economics"
  link="/research/industrial-policy"
  description="Quantitative analysis of state-led development..."
/>
```

### Project Archive
```astro
<ArchiveEntry 
  title="Design System Architecture"
  primaryMeta="Project"
  secondaryMeta="2023-2024"
  tertiaryMeta="In Progress"
  link="/projects/design-system"
  description="Building scalable design systems for modern web applications..."
/>
```

## Typography Features:
- Document-centric design without boxes or heavy decoration
- Semantic HTML structure with proper heading hierarchy  
- Baseline grid alignment following 6px system
- Advanced OpenType features for optimal text rendering
- Refined link styling with accessibility considerations
- Responsive typography scaling
- Flexible metadata structure for different content types

*/
export interface Props {
  title: string;
  primaryMeta: string;      // e.g., "Essay", "Research Paper", "Project"
  secondaryMeta: string;    // e.g., "March 2024", "2023-2024"
  tertiaryMeta?: string | undefined;    // e.g., "Design Systems", "Economics", "Featured"
  link: string;
  description?: string;
  class?: string;
}

const { 
  title, 
  primaryMeta,
  secondaryMeta, 
  tertiaryMeta,
  link, 
  description, 
  class: className = "" 
} = Astro.props;
---

<article class={`archive-entry ${className}`}>
  <!-- Title as primary heading with enhanced typography -->
  <h3 class="archive-title">
    <a 
      href={link} 
      class="link-title link-underline-thin"
    >
      {title}
    </a>
  </h3>
  
  <!-- Metadata with refined typography and OpenType features -->
  <div class="archive-meta">
    <span class="primary-meta">{primaryMeta}</span>
    <span class="separator" aria-hidden="true">•</span>
    <span class="secondary-meta">{secondaryMeta}</span>
    {tertiaryMeta && (
      <>
        <span class="separator" aria-hidden="true">•</span>
        <span class="tertiary-meta">{tertiaryMeta}</span>
      </>
    )}
  </div>
  
  <!-- Description with optimal reading settings -->
  {description && (
    <p class="archive-description">{description}</p>
  )}
</article>

<style>
  /* Archive entry container - document-centric approach */
  .archive-entry {
    /* Baseline grid alignment - Ruder's systematic spacing */
    padding-bottom: var(--space-4); /* 24px - 4 baseline units */
    
    /* Subtle structural division - Hochuli's restraint */
    border-bottom: 1px solid var(--theme-color-100);
    
    /* Remove border from last entry for clean ending */
    &:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
  }

  /* Title styling - Bringhurst's hierarchy principles */
  .archive-title {
    /* Typography scale following modular approach */
    font-size: var(--step-0); /* Base size for comfortable reading */
    font-weight: 500; /* Medium weight for distinction without heaviness */
    line-height: var(--line-height-heading); /* 1.2 for compact headings */
    
    /* Spacing following baseline grid */
    margin: 0 0 var(--space-2) 0; /* 12px bottom margin */
    
    /* OpenType features for optimal text rendering */
    font-feature-settings: 
      "kern" 1,     /* Kerning for better letter spacing */
      "liga" 1,     /* Ligatures for better character combinations */
      "calt" 1;     /* Contextual alternates */
    
    /* Color hierarchy - primary text */
    color: var(--theme-text);
  }

  /* Archive link now uses consolidated .link-title class - no custom styles needed */

  /* Metadata styling - Ambrose-Harris information hierarchy */
  .archive-meta {
    /* Typography scale for secondary information */
    font-size: var(--step--2); /* Smaller than title but readable */
    font-weight: 400; /* Normal weight for meta information */
    line-height: var(--line-height-base); /* Comfortable leading */
    
    /* Color hierarchy - secondary text */
    color: var(--theme-color-500);
    
    /* Spacing following baseline grid */
    margin: 0 0 var(--space-3) 0; /* 18px bottom margin */
    
    /* OpenType features for tabular data */
    font-feature-settings: 
      "kern" 1,     /* Kerning */
      "tnum" 0,     /* Don't force tabular nums for this context */
      "lnum" 1;     /* Lining numerals for dates */
    
    /* Layout for inline elements */
    display: flex;
    align-items: center;
    gap: var(--space-1); /* 6px between elements */
    flex-wrap: wrap; /* Allow wrapping on narrow screens */
  }

  /* Individual metadata elements */
  .primary-meta {
    font-weight: 450; /* Slightly heavier for type prominence */
  }

  .separator {
    opacity: 0.6; /* Subtle visual separation */
    font-weight: 400;
  }

  .secondary-meta {
    /* Optimized for date/time display */
    font-variant-numeric: lining-nums;
    letter-spacing: 0.01em; /* Slight opening for numbers */
  }

  .tertiary-meta {
    /* Type styling with subtle emphasis */
    font-style: italic;
    opacity: 0.8;
  }

  /* Description styling - optimized for reading */
  .archive-description {
    /* Typography for body text - Bringhurst's principles */
    font-size: var(--step--2); /* Consistent with refined Media page */
    font-weight: 400; /* Normal weight for body text */
    line-height: var(--line-height-relaxed); /* 1.6 for comfortable reading */
    
    /* Color hierarchy - body text */
    color: var(--theme-color-700);
    
    /* Spacing and margin */
    margin: 0;
    
    /* Optimal measure for readability - refined from Media page */
    max-width: 65ch; /* Perfect balance of readability and contrast */
    
    /* OpenType features for body text */
    font-feature-settings: 
      "kern" 1,     /* Kerning */
      "liga" 1,     /* Ligatures */
      "calt" 1,     /* Contextual alternates */
      "onum" 0;     /* Lining numbers (not oldstyle) for consistency */
    
    /* Paragraph refinements */
    hyphens: auto; /* Automatic hyphenation for better justification */
    text-rendering: optimizeLegibility; /* Browser optimization */
  }

  /* Dark mode adjustments */
  :global([data-theme="dark"]) .archive-entry {
    border-bottom-color: var(--theme-color-200);
  }
  
  :global([data-theme="dark"]) .archive-meta {
    color: var(--theme-color-400);
  }
  
  :global([data-theme="dark"]) .archive-description {
    color: var(--theme-color-600);
  }

  /* Responsive typography adjustments */
  @media (max-width: 640px) {
    .archive-entry {
      /* Tighter spacing on mobile - still following baseline grid */
      padding-bottom: var(--space-3); /* 18px - 3 baseline units */
    }
    
    .archive-title {
      /* Slightly smaller on mobile but maintain hierarchy */
      font-size: var(--step--1);
      line-height: 1.3; /* Tighter leading for mobile */
    }
    
    .archive-meta {
      /* Stack metadata on very narrow screens if needed */
      font-size: var(--step--2); /* Smallest available size on mobile */
    }
    
    .archive-description {
      /* Keep same size on mobile since we're already optimized */
      font-size: var(--step--2);
      line-height: 1.5; /* Slightly tighter for mobile reading */
    }
  }

  /* Print styles - Hochuli's media considerations */
  @media print {
    .archive-entry {
      /* Remove borders for print */
      border-bottom: none;
      
      /* Tighter spacing for print economy */
      padding-bottom: var(--space-2); /* 12px */
    }
    
    /* Print link styles now handled centrally in links.css */
  }
</style> 
