---
export interface Props {
	variant?: "primary" | "secondary" | "accent" | "inactive";
	size?: "sm" | "md" | "lg";
	title?: string;
	class?: string;
}

const { variant = "primary", size = "md", title, class: className = "" } = Astro.props as Props;

// Size classes
const sizeClasses = {
	sm: "h-4b px-3b text--3", // 24px height
	md: "h-5b px-4b text--2", // 30px height (default)
	lg: "h-6b px-5b text--1", // 36px height
};

// Badge base with typography refinements
const badgeClasses = {
	base: `
		inline-flex items-center justify-center
		rounded
		font-medium
		border
		transition-colors duration-150 ease-in-out
		contain-layout contain-style
		${sizeClasses[size]}
		${className}
	`,
	variants: {
		primary: "bg-color-900/8 text-textColor border-color-900/15 hover:border-color-900/25 dark:bg-color-100/12 dark:border-color-100/20 dark:hover:border-color-100/30",
		secondary: "bg-transparent text-light border-color-200/80 hover:border-color-300 dark:border-color-700/50 dark:hover:border-color-600",
		accent: "bg-accent text-white border-transparent hover:bg-accent/90",
		inactive: "bg-color-50 text-lighter border-color-100 opacity-60 cursor-not-allowed",
	},
};

const variantClasses = badgeClasses.variants[variant];
---

<span 
	class={`badge badge-${size} ${badgeClasses.base} ${variantClasses}`}
	data-badge-variant={variant}
>
	<span class="badge-text">
		{title}
		<slot />
	</span>
</span>

<style>
	/* Badge typography refinements */
	.badge {
		/* Enable font features */
		font-feature-settings: 'kern' 1, 'liga' 1, 'ss01' 1;
		/* Smooth rendering */
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		/* Base typography */
		text-transform: uppercase;
		letter-spacing: 0.04em; /* Reduced from 0.05em */
		line-height: 1;
		/* Width constraints */
		min-width: 4ch;
		max-width: 20ch;
		/* Grid alignment */
		margin-block: calc(var(--baseline) / 4); /* 6px */
		/* No shadows per typography masters */
		box-shadow: none;
		text-shadow: none;
	}
	
	/* Size-specific typography */
	.badge-sm {
		font-variation-settings: 'wght' 540; /* Heavier for tiny text */
	}
	
	.badge-md {
		font-variation-settings: 'wght' 520; /* Default weight */
	}
	
	.badge-lg {
		font-variation-settings: 'wght' 480; /* Lighter at larger sizes */
		text-transform: none; /* Sentence case for larger badges */
		letter-spacing: 0.01em;
	}
	
	/* Hover state - minimal changes */
	.badge:hover:not([data-badge-variant="inactive"]) {
		/* Border color changes handled by utility classes */
		/* No typography changes to prevent reflow */
	}
	
	/* Active state - micro-interaction only */
	.badge:active:not([data-badge-variant="inactive"]) {
		transform: translateY(0.5px);
	}
	
	/* Secondary variant - normal case */
	[data-badge-variant="secondary"] {
		text-transform: none;
		font-variation-settings: 'wght' 450;
		letter-spacing: 0.01em;
	}
	
	/* Accent variant - ensure maximum contrast */
	[data-badge-variant="accent"] {
		font-variation-settings: 'wght' 500;
		/* Ensure white text is always readable */
		color: white !important;
	}
	
	/* Inactive state */
	[data-badge-variant="inactive"] {
		font-variation-settings: 'wght' 400;
	}
	
	/* Remove dark mode text shadows */
	:root[data-theme="dark"] .badge {
		text-shadow: none;
	}
</style>
