---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";

const meta = {
  title: "Halyard Font Simulation",
  description: "Simulating Halyard font characteristics",
  articleDate: null,
  ogImage: null
};
---

<Base meta={meta}>
  <style>
    /* Simulate Halyard characteristics using available fonts */
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
    @import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500;600;700;800;900&display=swap');
    
    /* Halyard is a geometric sans-serif, similar to these alternatives */
    .simulate-halyard-display {
      /* Inter or Work Sans can approximate Halyard Display */
      font-family: 'Work Sans', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      /* Halyard Display has slightly tighter tracking */
      letter-spacing: -0.02em;
    }
    
    .simulate-halyard-text {
      /* For body text, Inter is a good approximation */
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      /* Halyard Text has neutral tracking */
      letter-spacing: -0.005em;
    }
    
    /* Apply to all elements for testing */
    .halyard-test h1,
    .halyard-test h2,
    .halyard-test h3,
    .halyard-test h4,
    .halyard-test h5,
    .halyard-test h6 {
      font-family: 'Work Sans', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
      letter-spacing: -0.02em;
    }
    
    .halyard-test p,
    .halyard-test li,
    .halyard-test span,
    .halyard-test div {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
      letter-spacing: -0.005em;
      font-weight: 400;
    }
    
    /* Adjust weights to match Halyard's optical sizing */
    .halyard-test h1 { font-weight: 700; }
    .halyard-test h2 { font-weight: 600; }
    .halyard-test h3 { font-weight: 500; }
    .halyard-test h4 { font-weight: 500; }
    .halyard-test h5 { font-weight: 600; }
    .halyard-test h6 { font-weight: 600; }
  </style>

  <div class="mx-auto max-w-3xl px-4">
    <PageHeader title="Halyard Font Simulation" />

    <div class="mb-12">
      <div class="p-4 bg-color-100 rounded-lg mb-8">
        <p class="text-sm font-semibold mb-2">About this simulation</p>
        <p class="text-sm">
          This page uses <strong>Work Sans</strong> for headlines and <strong>Inter</strong> for body text
          to approximate Halyard's characteristics. Both are geometric sans-serifs with similar proportions.
        </p>
      </div>
    </div>

    <div class="halyard-test">
      <!-- Side by side comparison -->
      <section class="space-y-16">
        <div>
          <h2 class="heading-3 mb-8">Side-by-Side Comparison</h2>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Current Design -->
            <div class="border border-color-200 rounded-lg p-6">
              <p class="text-meta mb-4">Current Design (Newsreader + IBM Plex Sans)</p>
              <div style="font-family: var(--font-headline); font-variation-settings: 'opsz' 72;">
                <h1 class="text-3xl mb-4">Typography Excellence</h1>
              </div>
              <div style="font-family: var(--font-body);">
                <p class="mb-4">
                  The art and technique of arranging type to make written language legible, 
                  readable, and appealing when displayed.
                </p>
                <h2 style="font-family: var(--font-headline); font-variation-settings: 'opsz' 16;" class="text-2xl mb-3">Design Principles</h2>
                <ul class="list-disc ml-6 space-y-1">
                  <li>Hierarchy and contrast</li>
                  <li>Consistency in spacing</li>
                  <li>Readability first</li>
                </ul>
              </div>
            </div>

            <!-- Halyard Simulation -->
            <div class="border border-color-200 rounded-lg p-6">
              <p class="text-meta mb-4">Halyard Simulation (Work Sans + Inter)</p>
              <h1 class="text-3xl mb-4">Typography Excellence</h1>
              <p class="mb-4">
                The art and technique of arranging type to make written language legible, 
                readable, and appealing when displayed.
              </p>
              <h2 class="text-2xl mb-3">Design Principles</h2>
              <ul class="list-disc ml-6 space-y-1">
                <li>Hierarchy and contrast</li>
                <li>Consistency in spacing</li>
                <li>Readability first</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Full Typography Scale -->
        <div>
          <h2 class="heading-3 mb-8">Halyard-Style Typography Scale</h2>
          
          <div class="space-y-6">
            <div>
              <p class="text-meta mb-2">Display (48px)</p>
              <h1 style="font-size: 3rem; line-height: 1.1;">The Future of Typography</h1>
            </div>
            
            <div>
              <p class="text-meta mb-2">Headline (32px)</p>
              <h2 style="font-size: 2rem; line-height: 1.2;">Designing for Digital Experiences</h2>
            </div>
            
            <div>
              <p class="text-meta mb-2">Title (24px)</p>
              <h3 style="font-size: 1.5rem; line-height: 1.3;">Modern Type Systems</h3>
            </div>
            
            <div>
              <p class="text-meta mb-2">Subtitle (20px)</p>
              <h4 style="font-size: 1.25rem; line-height: 1.4;">Component Typography</h4>
            </div>
            
            <div>
              <p class="text-meta mb-2">Body (16px)</p>
              <p style="font-size: 1rem; line-height: 1.6;">
                Good typography is invisible. It guides readers through content effortlessly, 
                creating a seamless reading experience that enhances comprehension and engagement.
              </p>
            </div>
            
            <div>
              <p class="text-meta mb-2">Caption (14px)</p>
              <p style="font-size: 0.875rem; line-height: 1.5;" class="text-light">
                Figure 1: Typography scales should maintain consistent proportions across all sizes.
              </p>
            </div>
          </div>
        </div>

        <!-- Character Showcase -->
        <div>
          <h2 class="heading-3 mb-8">Character Set</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <p class="text-meta mb-3">Uppercase</p>
              <p class="text-3xl tracking-wide">ABCDEFGHIJKLM<br/>NOPQRSTUVWXYZ</p>
            </div>
            
            <div>
              <p class="text-meta mb-3">Lowercase</p>
              <p class="text-3xl">abcdefghijklm<br/>nopqrstuvwxyz</p>
            </div>
            
            <div>
              <p class="text-meta mb-3">Numbers</p>
              <p class="text-3xl">0123456789</p>
            </div>
            
            <div>
              <p class="text-meta mb-3">Punctuation</p>
              <p class="text-3xl">.,;:!?'"()[]{}—–</p>
            </div>
          </div>
        </div>

        <!-- Real World Example -->
        <div>
          <h2 class="heading-3 mb-8">Real World Application</h2>
          
          <article class="prose max-w-none">
            <h1>The Evolution of Web Typography</h1>
            <p class="text-lead">
              From the early days of web-safe fonts to today's variable font technology, 
              web typography has undergone a dramatic transformation.
            </p>
            <p>
              Modern web typography offers unprecedented control over type rendering. 
              Variable fonts, CSS Grid, and advanced OpenType features enable designers 
              to create rich typographic experiences that rival print design.
            </p>
            <h2>Key Developments</h2>
            <p>
              The introduction of @font-face changed everything. Suddenly, designers 
              weren't limited to a handful of system fonts. This freedom sparked a 
              typography renaissance on the web.
            </p>
            <blockquote>
              <p>
                "Typography is what language looks like."
              </p>
              <cite>— Ellen Lupton</cite>
            </blockquote>
          </article>
        </div>
      </section>
    </div>

    <!-- Configuration Options -->
    <div class="mt-16 p-6 bg-color-100 rounded-lg space-y-4">
      <p class="text-sm font-semibold">If you want to use actual Halyard:</p>
      <ol class="text-sm list-decimal ml-6 space-y-2">
        <li>
          <strong>Adobe Fonts:</strong> Add Halyard to your kit at 
          <a href="https://fonts.adobe.com/fonts/halyard" class="link-inline">fonts.adobe.com/fonts/halyard</a>
        </li>
        <li>
          <strong>Purchase License:</strong> Buy from 
          <a href="https://www.dardenstudio.com/typefaces/halyard" class="link-inline">Darden Studio</a>
        </li>
        <li>
          <strong>Implementation:</strong> Update your Tailwind config:
          <pre class="mt-2 p-3 bg-color-900 text-color-100 rounded text-xs overflow-x-auto"><code>{`fontFamily: {
  headline: ['Halyard Display', 'Work Sans', ...fontFamily.sans],
  sans: ['Halyard Text', 'Inter', ...fontFamily.sans],
}`}</code></pre>
        </li>
      </ol>
    </div>
  </div>
</Base>