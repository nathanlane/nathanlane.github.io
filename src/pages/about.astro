---
import { getEntry, render } from "astro:content";
import PageHeader from "@/components/PageHeader.astro";
import StructuredData from "@/components/StructuredData.astro";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig, socialLinks } from "@/site.config";
import { renderMarkdown } from "@/utils/markdown";

const aboutPage = await getEntry("pages", "about");
if (!aboutPage) throw new Error("About page not found");

const { Content } = await render(aboutPage);
const { title, description, showPhoto, headerDescription } = aboutPage.data;

// Get social links from single source of truth
const twitterLink = socialLinks.find((l) => l.friendlyName === "Twitter")?.link || "";
const linkedInLink = socialLinks.find((l) => l.friendlyName === "LinkedIn")?.link || "";

const headerDescriptionMarkdown = headerDescription
	? headerDescription
			.replaceAll("{{email}}", siteConfig.email || "")
			.replaceAll("{{cvUrl}}", siteConfig.resumeUrl || "/cv.pdf")
			.replaceAll("{{twitterUrl}}", twitterLink)
			.replaceAll("{{linkedInUrl}}", linkedInLink)
			.replaceAll("{{departmentPage}}", siteConfig.departmentPage || "")
			.replaceAll("{{professionalPage}}", siteConfig.professionalPage || "")
	: undefined;

const headerDescriptionHtml = headerDescriptionMarkdown
	? await renderMarkdown(headerDescriptionMarkdown)
	: undefined;
---

<PageLayout meta={{ title, description }}>
	<StructuredData type="person" />
	<div class="measure-base mx-auto px-4b py-8b">

		<!-- Page Header with description -->
		<PageHeader
			title={title}
			{...(headerDescriptionHtml ? { description: headerDescriptionHtml } : {})}
		/>

		<!-- Main Content with Typography-First Design -->
		<div class="prose prose-lane max-w-none">

			<!-- Profile Photo - Elegant Float Treatment -->
			{showPhoto && (
				<figure class="float-right ml-6b mb-6b w-48 sm:w-56 -mt-2b">
					<div class="overflow-hidden border border-color-200 dark:border-color-700">
						<img
							src={siteConfig.profileImageFull || siteConfig.profileImage || "/headshot.jpg"}
							alt={`${siteConfig.author} headshot`}
							width={400}
							height={400}
							class="w-full h-auto aspect-square object-cover"
						/>
					</div>
					<figcaption class="text-center mt-2b">
						<a
							href={siteConfig.profileImageFull || "/headshot-full.JPG"}
							download
							class="link-nav text--2"
							data-variant="action"
						>
							Fullsize
						</a>
					</figcaption>
				</figure>
			)}

			<!-- MDX Content -->
			<Content />
		</div>

	</div>
</PageLayout>

<style>
	/* Apply editorial link style to all prose links by default */
	.prose a {
		color: var(--link-color-editorial, hsl(var(--theme-accent-base)));
		font-weight: 450;
		text-decoration: underline;
		text-decoration-color: var(--link-color-editorial, hsl(var(--theme-accent-base)));
		text-decoration-thickness: 0.05em;
		text-underline-offset: 0.2em;
	}
	
	.prose a:hover {
		color: var(--link-color-hover);
		text-decoration-color: var(--link-color-hover);
		text-decoration-thickness: 0.075em;
	}
	
	/* Override for the download link which has its own nav style */
	.prose .link-nav {
		font-weight: var(--link-weight-nav);
		text-decoration: none !important;
		border-bottom: none !important;
	}
</style>
