---
import ArchiveEntry from "@/components/ArchiveEntry.astro";
import Badge from "@/components/Badge.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const uniqueTags = getUniqueTags(allPosts);
const groupedByYear = groupPostsByYear(allPosts);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

// Calculate stats for description
const postCount = allPosts.length;
const yearCount = descYearKeys.length;
const oldestYear = descYearKeys[descYearKeys.length - 1];
const newestYear = descYearKeys[0];

// Create tag categories for better organization
const tagCategories = {
  "Economics & Policy": ["economics", "industrial-policy", "history", "globalization", "political-economy", "not-data"],
  "Technical & Programming": ["programming", "r", "rstats", "python", "data-science", "tutorials", "code", "web-development", "static-site"],
  "Research & Academic": ["bibliographies", "big-push", "research", "academic"],
  "Writing & Content": ["blog", "documentation", "guide", "tutorial", "writing"],
  "Design & Development": ["design", "design-systems", "typography", "css", "astro", "tailwind"],
  "Other Topics": uniqueTags.filter(tag => 
    !["economics", "industrial-policy", "history", "globalization", "political-economy", "not-data",
      "programming", "r", "rstats", "python", "data-science", "tutorials", "code", "web-development", "static-site",
      "bibliographies", "big-push", "research", "academic",
      "blog", "documentation", "guide", "tutorial", "writing",
      "design", "design-systems", "typography", "css", "astro", "tailwind"].includes(tag)
  ).sort()
};

const meta = {
  title: "Blog Archive",
  description: `${postCount} posts exploring economics, technology, and development from ${oldestYear} to ${newestYear}. Browse by year, topic, or search the complete archive.`
};

// Helper function to format date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { 
    month: 'short', 
    day: 'numeric'
  });
};

import type { CollectionItemBase } from '@/types';

// Helper function to determine post type based on tags and title
const getPostType = (post: CollectionItemBase) => {
  const tags = post.data.tags || [];
  const title = post.data.title.toLowerCase();
  
  // Check for specific patterns in tags or title
  if (tags.some((tag: string) => ['tutorial', 'guide', 'how-to'].includes(tag)) || 
      title.includes('how to') || title.includes('guide')) {
    return 'Tutorial';
  }
  if (tags.some((tag: string) => ['research', 'academic', 'bibliography'].includes(tag))) {
    return 'Research';
  }
  if (tags.some((tag: string) => ['programming', 'code', 'r', 'python'].includes(tag))) {
    return 'Technical';
  }
  if (tags.some((tag: string) => ['essay', 'opinion', 'analysis'].includes(tag))) {
    return 'Essay';
  }
  if (tags.includes('economics') || tags.includes('industrial-policy')) {
    return 'Economics';
  }
  
  return 'Post';
};

// Helper function to get primary tag for tertiary metadata
const getPrimaryTag = (post: CollectionItemBase) => {
  if (!post.data.tags || post.data.tags.length === 0) return undefined;
  
  // Prioritize certain tags as "primary"
  const priorityTags = ['economics', 'programming', 'design-systems', 'typography', 'industrial-policy', 'research'];
  const foundPriority = post.data.tags.find((tag: string) => priorityTags.includes(tag));
  
  if (foundPriority) {
    return foundPriority.split('-').map((word: string) => 
      word.charAt(0).toUpperCase() + word.slice(1)
    ).join(' ');
  }
  
  // Otherwise return the first tag, formatted nicely
  return post.data.tags?.[0]?.split('-').map((word: string) => 
    word.charAt(0).toUpperCase() + word.slice(1)
  ).join(' ');
};
---

<PageLayout meta={meta}>
  <div class="measure-base mx-auto px-4b py-8b">
    <!-- Page Header with improved typography and metadata -->
    <PageHeader 
      title="Blog Archive"
      description={`${postCount} posts exploring economics, technology, design, and development spanning ${yearCount} years (${oldestYear}–${newestYear}). A comprehensive collection of tutorials, essays, research notes, and technical documentation.`}
      additionalInfo={`<a href="/rss.xml">Subscribe to RSS</a> • <a href="/posts/1">Browse latest posts</a> • <a href="/tags">View all tags</a>`}
    />

    <!-- Browse by Topic Section -->
    <section class="mb-12b">
      <h2 class="heading-2 mb-6b">Browse by Topic</h2>
      
      <div class="space-y-6b">
        {Object.entries(tagCategories).map(([category, tags]) => (
          tags.length > 0 && (
            <div>
              <h3 class="heading-4 mb-3b">{category}</h3>
              <div class="flex flex-wrap gap-2b">
                {tags.map(tag => {
                  const count = allPosts.filter(p => p.data.tags?.includes(tag)).length;
                  return (
                    <a href={`/tags/${tag}`} class="inline-block">
                      <Badge variant="muted">{tag} ({count})</Badge>
                    </a>
                  );
                })}
              </div>
            </div>
          )
        ))}
      </div>
    </section>

    <!-- Posts by Year Section -->
    <section>
      <h2 class="heading-2 mb-6b">All Posts by Year</h2>
      
      <!-- Year-based archive listing -->
      <div class="space-y-12b">
        {descYearKeys.map(year => (
          <section id={`year-${year}`}>
            <!-- Year heading with post count -->
            <h3 class="heading-3 text-light mb-6b">
              {year}
              <span class="text-meta ml-2b">• {groupedByYear[year]!.length} posts</span>
            </h3>
            
            <!-- Posts for this year using ArchiveEntry component -->
            <div class="space-y-6b">
              {groupedByYear[year]!
                .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
                .map(post => (
                  <ArchiveEntry 
                    title={post.data.title}
                    primaryMeta={getPostType(post)}
                    secondaryMeta={formatDate(new Date(post.data.publishDate))}
                    tertiaryMeta={getPrimaryTag(post)}
                    link={`/posts/${post.id}/`}
                    description={post.data.description}
                  />
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </div>
</PageLayout>