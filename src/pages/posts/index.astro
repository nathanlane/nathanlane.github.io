---
import PageHeader from "@/components/PageHeader.astro";
import RecentContent from "@/components/RecentContent.astro";
import SectionSeparator from "@/components/SectionSeparator.astro";
import { getAllPosts, getUniqueTags } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const uniqueTags = getUniqueTags(allPosts);

const recentPosts = allPosts.slice(0, 5);

const meta = {
  title: "Blog Posts",
  description: "Technical tutorials, economic analysis, research notes, and occasional thoughts on data, policy, and development."
};
---

<PageLayout meta={meta}>
  <div class="measure-base mx-auto px-4b py-8b">
    <!-- Reusable Page Header with links -->
    <PageHeader 
      title="Blog Posts"
      description="Technical tutorials, economic analysis, research notes, and occasional thoughts on data, policy, and development."
      additionalInfo={`<a href="/posts/archive">Browse all posts</a> • Also see <a href="/writing">writing here</a>`}
    />

    <!-- Recent Posts using reusable component -->
    <RecentContent 
      title="Recent Posts"
      items={recentPosts}
      linkBase="/posts"
      archiveLink="/posts/archive"
      archiveLinkText="→ View all posts"
      showMetadata={true}
      maxItems={5}
      class="mb-16b"
    />

    <!-- Wide Full Header Line Separator -->
    <SectionSeparator variant="full-width" spacing="normal" />

    <!-- Navigation Options with improved typography -->
    <section>
      <h2 class="heading-2 mb-8b">More Ways to Browse</h2>
      
      <div class="grid sm:grid-cols-3 gap-6b">
        <a href="/posts/archive" class="block p-6b bg-theme-bg/30 hover:bg-theme-bg/50 transition-colors duration-200">
          <h4 class="heading-4 mb-2b">Full Archive</h4>
          <p class="text-meta text-light">All {allPosts.length} posts by year</p>
        </a>
        
        <a href="/tags" class="block p-6b bg-theme-bg/30 hover:bg-theme-bg/50 transition-colors duration-200">
          <h4 class="heading-4 mb-2b">Browse by Tag</h4>
          <p class="text-meta text-light">{uniqueTags.length} topics</p>
        </a>
        
        <a href="/posts/2" class="block p-6b bg-theme-bg/30 hover:bg-theme-bg/50 transition-colors duration-200">
          <h4 class="heading-4 mb-2b">Paginated View</h4>
          <p class="text-meta text-light">10 posts per page</p>
        </a>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  /* Link styling now handled by links.css */
</style>