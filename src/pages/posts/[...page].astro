---
import type { CollectionEntry } from "astro:content";
import Badge from "@/components/Badge.astro";
import Pagination from "@/components/Paginator.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import PostSearch from "@/components/blog/PostSearch.astro";
import { getAllPosts, getUniqueTagsWithCount, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import type { Page } from "@/types";

import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 10;
	const MAX_TAGS = 12;
	const allPosts = await getAllPosts();
	const allPostsCount = allPosts.length;
	const uniqueTags = getUniqueTagsWithCount(allPosts)
		.slice(0, MAX_TAGS)
		.map(([tag]) => tag);
	return paginate(
		allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()),
		{
			pageSize: MAX_POSTS_PER_PAGE,
			props: { uniqueTags, allPostsCount },
		},
	).filter(({ params }) => params.page);
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
	uniqueTags: string[];
	allPostsCount: number;
}

const { page, uniqueTags, allPostsCount } = Astro.props;

const meta = {
	description: "Read my collection of posts and the things that interest me",
	title: page.currentPage > 1 ? `Posts - Page ${page.currentPage}` : "Posts",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← Previous Page",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "Next Page →",
			url: page.url.next,
		},
	}),
};

const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout meta={meta}>
	<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4b mb-6b">
		<h1 class="flex items-center gap-2b">
			Posts
			<a class="text-accent-two" href="/rss.xml" target="_blank">
				<span class="sr-only">RSS feed</span>
				<Icon aria-hidden="true" class="icon-rss" focusable="false" name="lucide:rss" />
			</a>
		</h1>
		<div class="flex gap-4b text-sm">
			<a href="/posts/archive" class="link-inline">
				Browse Archive ({allPostsCount} posts)
			</a>
			<a href="/tags" class="link-inline">
				View All Tags
			</a>
		</div>
	</div>

	<!-- Search Bar (only on first page) -->
	{page.currentPage === 1 && <PostSearch />}

	<!-- Popular Tags -->
	{page.currentPage === 1 && (
		<div class="mb-6b">
			<h3 class="heading-4 mb-3b">Popular Topics</h3>
			<div class="flex flex-wrap gap-2b">
				{uniqueTags.map(tag => (
					<a href={`/tags/${tag}`}>
						<Badge variant="secondary">{tag}</Badge>
					</a>
				))}
			</div>
		</div>
	)}

	<div class="grid gap-y-8b">
		<section aria-label="Blog post list" class="grow">
			{
				descYearKeys.map((yearKey) => (
					<>
						<h4 class="heading-4" data-year-header={yearKey}>{yearKey}</h4>
						<ul class="mb-8b mt-4b space-y-8b text-start">
							{groupedByYear[yearKey]?.map((p) => (
								<li 
									class="grid gap-2b sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2"
									data-post-item
									data-post-title={p.data.title}
									data-post-tags={p.data.tags?.join(" ") || ""}
									data-post-year={yearKey}
								>
									<PostPreview post={p} withDesc={true} />
								</li>
							))}
						</ul>
					</>
				))
			}
		</section>
	</div>
	<Pagination {...paginationProps} />
</PageLayout>
