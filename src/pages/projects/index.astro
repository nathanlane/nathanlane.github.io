---
import { getCollection } from "astro:content";
import ProjectCard from "@/components/ProjectCard.astro";
import BaseLayout from "@/layouts/Base.astro";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort((a, b) =>
	b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const featuredProjects = sortedProjects.filter(project => project.data.featured);
const otherProjects = sortedProjects.filter(project => !project.data.featured);
---

<BaseLayout meta={{ title: "Projects", description: "A collection of design and development projects focused on typography and user experience." }}>
	<h1>Projects</h1>

	<p class="text-fluid-1 text-light mb-8b max-w-2xl">
		A showcase of design and development work, focusing on typography systems, component libraries, and user experience improvements.
	</p>

	{featuredProjects.length > 0 && (
		<section class="mb-12b">
			<h2 class="mb-6b">Current Projects</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-l">
				{featuredProjects.map((project) => (
					<ProjectCard
						title={project.data.title}
						description={project.data.description}
						url={`/projects/${project.id}/`}
					/>
				))}
			</div>
		</section>
	)}

	{otherProjects.length > 0 && (
		<section>
			<h2 class="mb-6b">All Projects</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-component-gap">
				{otherProjects.map((project) => (
					<ProjectCard
						title={project.data.title}
						description={project.data.description}
						url={`/projects/${project.id}/`}
					/>
				))}
			</div>
		</section>
	)}
</BaseLayout>