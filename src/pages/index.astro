---
import { type CollectionEntry, getCollection, getEntry } from "astro:content";
import BioPanel from "@/components/BioPanel.astro";
// import ContactInfo from "@/components/ContactInfo.astro";
import DocumentEntry from "@/components/DocumentEntry.astro";
import DocumentSection from "@/components/DocumentSection.astro";
import MediaList from "@/components/MediaList.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { mediaData } from "@/data/media";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";


// Get homepage content from content collection
const homepageContent = await getEntry("homepage", "index");
if (!homepageContent) {
	throw new Error("Homepage content not found");
}
const { bio, contact } = homepageContent.data;

// Get featured research papers
const allResearch = await getCollection("research");
const featuredResearch = allResearch
	.filter(paper => paper.data.featured)
	.sort((a, b) => Number.parseInt(b.data.paperDate) - Number.parseInt(a.data.paperDate))
	.slice(0, 3);

// Get recent posts/essays
const allPosts = await getAllPosts();
const recentPosts = allPosts
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
	.slice(0, 3);

// Get latest writing pieces
const allWriting = await getCollection("writing");
const latestWriting = allWriting
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 2);

// Get latest media appearances
const allMediaItems = Object.entries(mediaData)
	.flatMap(([year, items]) => items)
	.sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
	.slice(0, 5);

// Prepare Table of Contents sections for Important Links
const importantLinksSections = contact?.items?.map((item) => ({
	title: item.text,
	href: item.href
})) || [];
---

<PageLayout meta={{ 
	title: "Home",
	description: "Nathan Lane is an Associate Professor of Economics at Oxford University, specializing in industrial policy, economic development, and the intersection of technology and economics. Co-founder of the Industrial Policy Group."
}}>
	<div class="homepage-document">
		


		<!-- Bio Panel Integration -->
		{bio && (
			<BioPanel bio={bio} class="mb-16b" />
		)}

		<!-- Research Section -->
		<DocumentSection 
			title="Recent Research" 
			viewAllText="View all research" 
			viewAllHref="/research/"
		>
			{featuredResearch.map((paper) => (
				<DocumentEntry
					title={paper.data.title}
					href={`/research/${paper.id}/`}
					type="research"
					date={paper.data.paperDate}
					status={paper.data.status}
					description={paper.data.description}
					metadata={paper.data.authors}
				/>
			))}
		</DocumentSection>

		<!-- Writing -->
		<DocumentSection 
			title="Recent Writing" 
			viewAllText="View all writing" 
			viewAllHref="/writing/"
		>
			{latestWriting.map((piece) => (
				<DocumentEntry
					title={piece.data.title}
					href={`/writing/${piece.id}/`}
					type="writing"
					date={piece.data.publishDate.toISOString()}
					description={piece.data.description}
				/>
			))}
		</DocumentSection>

		<!-- Media & Appearances -->
		<DocumentSection 
			title="Recent in the News" 
			viewAllText="View all media" 
			viewAllHref="/media/"
		>
			<MediaList items={allMediaItems} />
		</DocumentSection>

		<!-- Important Links -->
		<DocumentSection title="">
			<TableOfContents 
				sections={importantLinksSections}
				headerText="Important Links"
				showHeader={true}
				showNumbers={false}
			/>
		</DocumentSection>
		
	</div>
</PageLayout>

<style>
	/* Homepage document container */
	.homepage-document {
		max-width: var(--measure-base); /* Single source of truth */
		margin: 0 auto;
		padding: var(--space-8) var(--space-4); /* 48px 24px */
	}

	/* Responsive adjustments */
	@media (max-width: 768px) {
		.homepage-document {
			padding: var(--space-6) var(--space-3); /* 36px 18px */
		}
	}
</style>

