---
import { getCollection, getEntry, render } from "astro:content";
import DocumentEntry from "@/components/DocumentEntry.astro";
import DocumentSection from "@/components/DocumentSection.astro";
import MediaList from "@/components/MediaList.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig, socialLinks } from "@/site.config";
import { isPublishedEntry } from "@/utils/content";

// Get homepage CONTENT from MDX
const homepageContent = await getEntry("pages", "homepage");
if (!homepageContent) {
	throw new Error("Homepage content not found");
}
const { Content } = await render(homepageContent);
const homepageData = homepageContent.data;

// Identity data for the homepage header (from siteConfig + MDX frontmatter)
const bio = {
	title: siteConfig.fullName || siteConfig.title,
	tagline: undefined, // Explicitly set to undefined since it's not used
	// We'll render MDX content separately, so pass empty string
	narrative: "",
	affiliations: [
		{
			title: siteConfig.organization || "Unknown Organization",
			role: siteConfig.jobTitle || "Researcher",
		},
		// Add secondary affiliation if provided in MDX frontmatter
		...(homepageData.secondaryAffiliation ? [homepageData.secondaryAffiliation] : []),
	],
};

// Auto-generate contact from siteConfig + append custom links from MDX
const githubLink = socialLinks.find((l) => l.friendlyName === "Github");
const contact = {
	title: "Important Links",
	email: siteConfig.email,
	items: [
		// Auto-generated standard links from siteConfig
		...(githubLink
			? [
					{
						label: "GitHub",
						href: githubLink.link,
						text: "GitHub",
					},
				]
			: []),
		{
			label: "Email",
			href: `mailto:${siteConfig.email}`,
			text: "Email Me",
		},
		{
			label: "CV",
			href: siteConfig.resumeUrl || "/cv.pdf",
			text: "Download CV",
		},
		// Append custom links from MDX frontmatter
		...(homepageData.contactLinks || []),
	],
};

// Get featured research papers
const allResearch = await getCollection("research");
const featuredResearch = allResearch
	.filter((paper) => paper.data.featured)
	.sort((a, b) => Number.parseInt(b.data.paperDate) - Number.parseInt(a.data.paperDate))
	.slice(0, 3);

// Note: getAllPosts is imported but not used directly on homepage
// Keep import as it may be needed for future features

// Get latest writing pieces
const allWriting = (await getCollection("writing")).filter(isPublishedEntry);
const latestWriting = allWriting
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 2);

// Get latest media appearances
const mediaEntries = await getCollection("media");
const allMediaItems = mediaEntries
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 5)
	.map((entry) => ({
		title: entry.data.title,
		outlet: entry.data.outlet,
		date: entry.data.date.toISOString(),
		type: entry.data.type,
		link: entry.data.link,
		description: entry.data.description,
	}));

// Prepare Table of Contents sections for Important Links
const importantLinksSections =
	contact?.items?.map((item) => ({
		title: item.text,
		href: item.href,
	})) || [];
---

<PageLayout
	meta={{
		title: "Home",
		description:
			"Nathan Lane is an economics professor and empirical economist at the London School of Economics, specializing in economic development, industrial policy, political economy, and empirical methods. Co-founder of the Industrial Policy Group.",
	}}
>
	<div class="homepage-document">
		<!-- Bio Panel Header (title and tagline only) -->
		<header class="mb-8b">
			<h1 class="heading-1 text-accent-base mb-3b">{bio.title}</h1>
			{bio.tagline && <p class="text-2 text-light font-body leading-relaxed">{bio.tagline}</p>}
		</header>

		<!-- Homepage Bio Narrative (MDX Content) -->
		<div class="narrative prose prose-lane max-w-none mb-16b">
			<Content />
		</div>

		<!-- Research Section -->
		<DocumentSection
			title="Recent Research"
			viewAllText="View all research"
			viewAllHref="/research/"
		>
			{
				featuredResearch.map((paper) => (
					<DocumentEntry
						title={paper.data.title}
						href={`/research/${paper.id}/`}
						type="research"
						date={paper.data.paperDate}
						status={paper.data.status}
						description={paper.data.description}
						metadata={paper.data.authors}
					/>
				))
			}
		</DocumentSection>

		<!-- Writing -->
		<DocumentSection title="Recent Writing" viewAllText="View all writing" viewAllHref="/writing/">
			{
				latestWriting.map((piece) => (
					<DocumentEntry
						title={piece.data.title}
						href={`/writing/${piece.id}/`}
						type="writing"
						date={piece.data.publishDate.toISOString()}
						description={piece.data.description}
					/>
				))
			}
		</DocumentSection>

		<!-- Media & Appearances -->
		<DocumentSection title="Recent in the News" viewAllText="View all media" viewAllHref="/media/">
			<MediaList items={allMediaItems} />
		</DocumentSection>

		<!-- Important Links -->
		<DocumentSection title="">
			<TableOfContents
				sections={importantLinksSections}
				headerText="Important Links"
				showHeader={true}
				showNumbers={false}
			/>
		</DocumentSection>
	</div>
</PageLayout>

<style>
	/* Homepage document container */
	.homepage-document {
		max-width: var(--measure-base); /* Single source of truth */
		margin: 0 auto;
		padding: var(--space-8) var(--space-4); /* 48px 24px */
	}

	/* Homepage header styling */
	.homepage-document header h1 {
		letter-spacing: -0.02em;
	}

	/* Narrative typography - larger font size */
	.narrative :global(p) {
		@apply text-1 leading-relaxed mb-6b;
	}

	.narrative :global(p:last-child) {
		@apply mb-0;
	}

	/* Apply editorial link style to all narrative links */
	.narrative a {
		color: var(--link-color-editorial, hsl(var(--theme-accent-base)));
		font-weight: 450;
		text-decoration: underline;
		text-decoration-color: var(--link-color-editorial, hsl(var(--theme-accent-base)));
		text-decoration-thickness: 0.05em;
		text-underline-offset: 0.2em;
	}

	.narrative a:hover {
		color: var(--link-color-hover);
		text-decoration-color: var(--link-color-hover);
		text-decoration-thickness: 0.075em;
	}

	/* Responsive adjustments */
	@media (max-width: 768px) {
		.homepage-document {
			padding: var(--space-6) var(--space-3); /* 36px 18px */
		}
	}
</style>
