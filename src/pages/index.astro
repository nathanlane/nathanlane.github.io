---
import { type CollectionEntry, getCollection, getEntry } from "astro:content";
import Button from "@/components/Button.astro";
import CompactList from "@/components/CompactList.astro";
import ContactBox from "@/components/ContactBox.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionGrid from "@/components/SectionGrid.astro";
import SocialList from "@/components/SocialList.astro";
import WritingCard from "@/components/WritingCard.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Note from "@/components/note/Note.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { socialLinks, siteConfig } from "@/site.config";
import { collectionDateSort } from "@/utils/date";
import { mediaData } from "@/data/media";

// Get homepage content from content collection
const homepageContent = await getEntry("homepage", "index");
if (!homepageContent) {
	throw new Error("Homepage content not found");
}
const { hero, currentProjects, contact, showcase, posts: postsConfig } = homepageContent.data;

// Get content section configs with defaults
const researchConfig = showcase.contentSections?.research || {
	title: "Recent Papers",
	itemCount: 3,
	viewAllText: "View all research papers",
	viewAllUrl: "/research/"
};
const writingConfig = showcase.contentSections?.writing || {
	title: "Recent Writing",
	itemCount: 2,
	viewAllText: "View all writing",
	viewAllUrl: "/writing/"
};
const mediaConfig = showcase.contentSections?.media || {
	title: "Recent Media",
	itemCount: 5,
	viewAllText: "View all media coverage",
	viewAllUrl: "/media/"
};

// Posts
const allPosts = await getAllPosts();
const allPostsByDate = allPosts
	.sort(collectionDateSort)
	.slice(0, postsConfig.maxPosts) as CollectionEntry<"post">[];

// Notes
const MAX_NOTES = 2;
const allNotes = await getCollection("note");
const latestNotes = allNotes.sort(collectionDateSort).slice(0, MAX_NOTES);

// Get showcase sections for component demos
const projectsSection = showcase.sections.find(s => s.type === "projects");
const writingSection = showcase.sections.find(s => s.type === "writing");
const compactSection = showcase.sections.find(s => s.type === "compact");

// Get featured research papers
const allResearch = await getCollection("research");
const featuredResearch = allResearch
	.filter(paper => paper.data.featured)
	.sort((a, b) => Number.parseInt(b.data.paperDate) - Number.parseInt(a.data.paperDate))
	.slice(0, researchConfig.itemCount);

// Get latest writing pieces
const allWriting = await getCollection("writing");
const latestWriting = allWriting
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, writingConfig.itemCount);

// Get latest media appearances
const allMediaItems = Object.entries(mediaData)
	.flatMap(([year, items]) => items)
	.sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
	.slice(0, mediaConfig.itemCount);
---

<PageLayout meta={{ title: "Home" }}>
	<!-- Hero section -->
	<!-- Simplified background - removed decorative gradient orbs for minimal aesthetic -->
	<section class="max-w-xl mx-auto relative flex items-center justify-center min-h-[40vh]">
		<div class="w-full text-center">
			<h1 class="text-center">
				{hero.title}
			</h1>
			<p class="text-body mt-4b mb-4b">
				{hero.description}
			</p>
			<div class="flex justify-center mb-4b">
				<SocialList />
			</div>
			<div class="flex justify-center gap-3 mt-6b">
				{hero.buttons.map((button) => (
					<Button 
						href={button.href} 
						variant={button.variant as "primary" | "secondary"}
						size="sm"
					>
						{button.text}
					</Button>
				))}
			</div>
		</div>
	</section>

	<!-- Current Work & Contact Section -->
	<section class="mt-2b">
		<h2>
			Current Work & Contact
		</h2>
		
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 space-y-4 items-start">
			<!-- Left Column: Current Projects -->
			<div>
				<h3>{currentProjects.title}</h3>
				<div class="space-y-6">
					{currentProjects.projects.map((project) => (
						<article class="space-y-2">
							<h4>
								<a href={project.url} class="inline-link hover:text-accent-base">
									{project.title}
								</a>
							</h5>
							<p class="text-body-sm leading-relaxed">
								{project.description}
							</p>
						</article>
					))}
				</div>
			</div>

			<!-- Right Column: More Content -->
			<div>
				<ContactBox />
			</div>
		</div>
	</section>

	<!-- Component Showcase Section -->
	<section class="mt-2b">
		<h2>
			{showcase.title}
		</h2>
		
		{/* Recent Papers Grid */}
		<div class="mb-4b">
			<h3 class="font-headline font-medium mb-3b">{researchConfig.title}</h3>
			<SectionGrid columns="3" gap="md">
				{featuredResearch.map((paper) => (
					<ProjectCard 
						title={paper.data.title}
						description={paper.data.description}
						url={`/research/${paper.data.slug || paper.id}/`}
					/>
				))}
			</SectionGrid>
		</div>

		{/* Writing Cards */}
		<div class="mb-4b">
			<h3 class="font-headline font-medium mb-3b">{writingConfig.title}</h3>
			<SectionGrid columns="2" gap="md">
				{latestWriting.map((piece) => (
					<WritingCard 
						title={piece.data.title}
						excerpt={piece.data.description}
						date={piece.data.publishDate}
						url={`/writing/${piece.data.slug || piece.id}/`}
					/>
				))}
			</SectionGrid>
		</div>

		{/* Media Appearances */}
		<div class="mb-4b">
			<h3 class="font-headline font-medium mb-3b">{mediaConfig.title}</h3>
			<CompactList items={allMediaItems.map(item => ({
				title: item.title,
				description: `${item.outlet} • ${new Date(item.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`,
				url: item.link
			}))} />
		</div>
	</section>

	<!-- Posts Section -->
	<section aria-label="Blog post list" class="mt-2b">
		<h2 class="font-headline font-medium mb-3b">{postsConfig.title}</h2>
		<ul class="space-y-6 md:space-y-2" role="list">
			{
				allPostsByDate.map((p) => (
					<li class="gap-2 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>


