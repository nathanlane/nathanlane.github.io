---
import { type CollectionEntry, getCollection, getEntry } from "astro:content";
import BioPanel from "@/components/BioPanel.astro";
import DocumentEntry from "@/components/DocumentEntry.astro";
import DocumentSection from "@/components/DocumentSection.astro";
import MediaList from "@/components/MediaList.astro";
import ContactInfo from "@/components/ContactInfo.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import { mediaData } from "@/data/media";

// Get homepage content from content collection
const homepageContent = await getEntry("homepage", "index");
if (!homepageContent) {
	throw new Error("Homepage content not found");
}
const { hero, bio } = homepageContent.data;

// Get featured research papers
const allResearch = await getCollection("research");
const featuredResearch = allResearch
	.filter(paper => paper.data.featured)
	.sort((a, b) => Number.parseInt(b.data.paperDate) - Number.parseInt(a.data.paperDate))
	.slice(0, 3);

// Get recent posts/essays
const allPosts = await getAllPosts();
const recentPosts = allPosts
	.sort(collectionDateSort)
	.slice(0, 3) as CollectionEntry<"post">[];

// Get latest writing pieces
const allWriting = await getCollection("writing");
const latestWriting = allWriting
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 2);

// Get latest media appearances
const allMediaItems = Object.entries(mediaData)
	.flatMap(([year, items]) => items)
	.sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
	.slice(0, 5);
---

<PageLayout meta={{ title: "Home" }}>
	<div class="homepage-document">
		
		<!-- Document Masthead -->
		<header class="document-masthead">
			<h1 class="site-title">{hero.title}</h1>
			<p class="site-description">
				{hero.description}
			</p>
		</header>

		<!-- Bio Panel Integration -->
		{bio && (
			<BioPanel bio={bio} class="mb-16b" />
		)}

		<!-- Research Section -->
		<DocumentSection 
			title="Research" 
			viewAllText="View all papers" 
			viewAllHref="/research/"
		>
			{featuredResearch.map((paper) => (
				<DocumentEntry
					title={paper.data.title}
					href={`/research/${paper.data.slug || paper.id}/`}
					type="research"
					date={paper.data.paperDate}
					status={paper.data.status}
					description={paper.data.description}
					metadata={paper.data.authors}
				/>
			))}
		</DocumentSection>

		<!-- Recent Essays -->
		<DocumentSection 
			title="Recent Essays" 
			viewAllText="View all posts" 
			viewAllHref="/posts/"
		>
			{recentPosts.map((post) => (
				<DocumentEntry
					title={post.data.title}
					href={`/posts/${post.slug}/`}
					type="post"
					date={post.data.publishDate.toISOString()}
					description={post.data.description}
				/>
			))}
		</DocumentSection>

		<!-- Writing -->
		<DocumentSection 
			title="Writing" 
			viewAllText="View all writing" 
			viewAllHref="/writing/"
		>
			{latestWriting.map((piece) => (
				<DocumentEntry
					title={piece.data.title}
					href={`/writing/${piece.data.slug || piece.id}/`}
					type="writing"
					date={piece.data.publishDate.toISOString()}
					description={piece.data.description}
				/>
			))}
		</DocumentSection>

		<!-- Media & Appearances -->
		<DocumentSection title="Media & Appearances">
			<MediaList items={allMediaItems} />
		</DocumentSection>

		<!-- Contact Information -->
		<ContactInfo />
		
	</div>
</PageLayout>

<style>
	/* Homepage document container */
	.homepage-document {
		max-width: var(--measure-base); /* Single source of truth */
		margin: 0 auto;
		padding: var(--space-8) var(--space-4); /* 48px 24px */
	}

	/* Document masthead */
	.document-masthead {
		margin-bottom: var(--space-16); /* 96px - major break */
		text-align: left; /* Left-aligned for document feel */
	}

	.site-title {
		font-family: var(--font-newsreader);
		font-size: var(--step-3); /* 29.3-33.2px */
		font-weight: 400;
		letter-spacing: -0.025em;
		margin-bottom: var(--space-4); /* 24px */
		line-height: 1.2;
		color: var(--theme-text);
	}

	.site-description {
		font-size: var(--step-1); /* 18.8-21.3px */
		line-height: 1.6;
		color: var(--theme-text);
		margin-bottom: 0;
		font-weight: 300;
		max-width: var(--measure-narrow); /* Slightly narrower than container for readability */
	}

	/* Responsive adjustments */
	@media (max-width: 768px) {
		.homepage-document {
			padding: var(--space-6) var(--space-3); /* 36px 18px */
		}
		
		.site-title {
			font-size: var(--step-2); /* Smaller on mobile */
		}
		
		.site-description {
			font-size: var(--step-0); /* Standard body size */
		}
	}

	/* Dark mode adjustments */
	:global([data-theme="dark"]) .site-title {
		font-weight: 425; /* Slightly heavier for dark mode */
	}

	:global([data-theme="dark"]) .site-description {
		color: var(--theme-color-100);
	}
</style>

