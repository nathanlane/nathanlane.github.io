---
import Badge from '@/components/Badge.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import Separator from '@/components/Separator.astro';
import Base from '@/layouts/Base.astro';
import { siteConfig } from '@/site.config';

// Mock data to populate the page, using real titles from the project for realism.
const MOCK_POSTS = [
	{
		title: 'Design System Audit and Refactoring Plan',
		slug: '/posts/design-system-audit-and-refactoring-plan',
		date: new Date('2024-07-22'),
		description:
			'A deep dive into the process of identifying typographic inconsistencies and creating a rule-based system for a cleaner, more maintainable codebase.',
		tags: ['Design Systems', 'Typography', 'Refactoring'],
	},
	{
		title: 'Grid System Optimization',
		slug: '/posts/grid-system-optimization',
		date: new Date('2024-07-15'),
		description:
			'Moving beyond simple grids to implement a baseline-aligned spacing system for perfect vertical rhythm and visual harmony.',
		tags: ['CSS', 'Design Systems', 'Frontend'],
	},
	{
		title: 'A Basic Tutorial for Digitizing Historic Tabular Data',
		slug: '/posts/a-basic-tutorial-for-digitizing-historic-tabular-data',
		date: new Date('2024-06-30'),
		description:
			'Practical steps and considerations for turning scanned tables from historical documents into usable, clean digital datasets.',
		tags: ['Data', 'History', 'Tutorial'],
	},
];

const MOCK_NOTES = [
	{
		title: 'The F-Pattern and Resumes',
		slug: '/notes/resume-f-method',
		date: new Date('2024-07-18'),
		description:
			"A quick thought on how the F-shaped reading pattern applies to resume design and what it means for information hierarchy.",
	},
	{
		title: 'Welcome to the Digital Garden',
		slug: '/notes/welcome',
		date: new Date('2024-05-01'),
		description: 'Setting the intention for this space as a place for learning in public and exploring connected ideas.',
	},
];

const MOCK_PROJECTS = [
	{
		title: 'The Philosophy of Design Systems',
		slug: '/projects/design-systems-philosophy',
		date: new Date('2024-07-01'),
		description:
			'An exploration of the principles behind building and maintaining design systems that are scalable, adaptable, and a joy to use.',
		tags: ['Design', 'Systems Thinking'],
	},
	{
		title: 'The Future of Typography on the Web',
		slug: '/projects/future-of-typography',
		date: new Date('2024-06-11'),
		description: 'Speculations on where web typography is headed, from variable fonts to AI-driven layout engines.',
		tags: ['Typography', 'Web Design', 'Futures'],
	},
];

const pageTitle = `Homepage Mockup | ${siteConfig.title}`;
---

<Base meta={{ title: pageTitle }}>
	<main class="mx-auto max-w-prose px-4b">
		<header class="py-12b text-center">
			<h1 class="heading-1 mb-2b">Nathan Lane, PhD</h1>
			<p class="text-lg text-pretty">
				A digital garden of thoughts, research, and experiments. This is a living document, structured by typography
				and whitespace, not by boxes and containers.
			</p>
		</header>

		<Separator />

		<section class="py-8b">
			<header class="mb-6b">
				<h2 class="heading-2">Recent Writing</h2>
			</header>
			<div class="space-y-8b">
				{
					MOCK_POSTS.map((post) => (
						<article>
							<a href={post.slug} class="text-link no-underline hover:underline focus-visible:underline">
								<h3 class="heading-3 mb-1b">{post.title}</h3>
							</a>
							<p class="mb-2b text-pretty">{post.description}</p>
							<div class="flex items-center gap-x-4b gap-y-2b text-sm text-fg-muted">
								<FormattedDate date={post.date} />
								<div class="flex flex-wrap gap-x-2b gap-y-1b">
									{post.tags.map((tag) => (
										<Badge title={tag} />
									))}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<Separator />

		<section class="py-8b">
			<header class="mb-6b">
				<h2 class="heading-2">Field Notes</h2>
			</header>
			<div class="space-y-6b">
				{
					MOCK_NOTES.map((note) => (
						<article>
							<a href={note.slug} class="text-link no-underline hover:underline focus-visible:underline">
								<h4 class="heading-4 mb-1b">{note.title}</h4>
							</a>
							<p class="text-pretty text-fg-muted">{note.description}</p>
						</article>
					))
				}
			</div>
		</section>

		<footer class="py-8b text-center">
			<a href="/about" class="text-link text-lg hover:underline focus-visible:underline">
				More about me
			</a>
		</footer>

	</main>
</Base> 