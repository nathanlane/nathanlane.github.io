---
import { Icon } from "astro-icon/components";
import PageLayout from "@/layouts/Base.astro";
import { mediaData, type MediaItem } from "@/data/media";

const meta = {
  title: "Media",
  description: "Interviews, podcasts, talks, and press coverage"
};

// Media type icons
const mediaIcons: Record<MediaItem['type'], string> = {
  interview: "lucide:mic",
  podcast: "lucide:headphones",
  video: "lucide:play-circle",
  article: "lucide:newspaper",
  press: "lucide:megaphone",
  talk: "lucide:presentation",
  panel: "lucide:users"
};

// Get years in descending order
const years = Object.keys(mediaData).sort((a, b) => Number(b) - Number(a));
---

<PageLayout meta={meta}>
  <div class="max-w-3xl mx-auto">
    <header class="mb-8b">
      <h1 class="heading-1 mb-4b">Media</h1>
      <p class="text-light">
        Interviews, podcasts, talks, and press coverage
      </p>
    </header>

    <div class="space-y-8">
      {years.map(year => (
        <section>
          <h2 class="text-lg font-medium text-light mb-4b">{year}</h2>
          <ul class="space-y-3">
            {mediaData[Number(year)]
              ?.sort((a: MediaItem, b: MediaItem) => new Date(b.date).getTime() - new Date(a.date).getTime())
              ?.map((item: MediaItem) => (
              <li class="flex gap-3 group">
                <Icon 
                  name={mediaIcons[item.type] || "lucide:link"} 
                  class="w-3 h-3 mt-1b text-light opacity-50 flex-shrink-0"
                />
                <div class="flex-grow">
                  <a 
                    href={item.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-baseline gap-1 text-accent-base hover:text-accent font-medium"
                  >
                    {item.title}
                    <Icon 
                      name="lucide:arrow-up-right" 
                      class="w-3 h-3 opacity-60"
                    />
                  </a>
                  <div class="text-sm text-light mt-0.5">
                    {item.outlet} • {new Date(item.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                  </div>
                  {item.description && (
                    <p class="text-sm text-textColor mt-1b">{item.description}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</PageLayout>

<style>
  /* Simple hover effect */
  li:hover {
    @apply bg-color-50 -mx-3b px-3b py-2b rounded-sm;
  }
  
  :root[data-theme="dark"] li:hover {
    @apply bg-color-200;
  }
</style>