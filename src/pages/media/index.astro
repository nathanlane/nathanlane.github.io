---
import MediaEntry from "@/components/MediaEntry.astro";
import PageHeader from "@/components/PageHeader.astro";
import { type MediaItem, mediaData } from "@/data/media";
import PageLayout from "@/layouts/Base.astro";

const meta = {
  title: "Media",
  description: "Interviews, podcasts, talks, and press coverage"
};

// Get years in descending order
const years = Object.keys(mediaData).sort((a, b) => Number(b) - Number(a));
---

<PageLayout meta={meta}>
  <div class="measure-base mx-auto px-4b py-8b">
    <!-- Reusable Page Header with proper typography and spacing -->
    <PageHeader 
      title="Media"
      description="Interviews, podcasts, talks, and press coverage exploring economics, technology, and digital transformation."
      additionalInfo="Subscribe to podcast RSS • Request speaking engagement • Media kit"
    />

    <!-- Media entries organized by year with proper baseline grid spacing -->
    <div class="space-y-12b">
      {years.map(year => (
        <section>
          <!-- Year heading using semantic typography and baseline grid -->
          <h2 class="heading-3 text-light mb-6b">{year}</h2>
          
          <!-- Media items list with proper grid spacing -->
          <div class="space-y-6b">
            {mediaData[Number(year)]
              ?.sort((a: MediaItem, b: MediaItem) => new Date(b.date).getTime() - new Date(a.date).getTime())
              ?.map((item: MediaItem) => (
                <MediaEntry 
                  title={item.title}
                  outlet={item.outlet}
                  date={item.date}
                  type={item.type}
                  link={item.link}
                  description={item.description}
                />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</PageLayout>