          </div>
        </div>
        
        <!-- Option 3 + Option 4 -->
        <div>
          <div class="border border-color-200 rounded-lg p-6 mb-6 inter-headlines inter-body">
            <p class="text-meta mb-4">With Inter</p>
            <article>
              <h1 class="heading-2 mb-2">Understanding Modern Typography</h1>
