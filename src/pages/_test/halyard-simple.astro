---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";

const meta = {
  title: "Halyard Font Test",
  description: "Testing Halyard-style fonts",
  articleDate: null,
  ogImage: null
};
---

<Base meta={meta}>
  <div class="mx-auto max-w-3xl px-4">
    <PageHeader>
      Halyard Font Test
    </PageHeader>

    <style is:inline>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
      @import url('https://fonts.googleapis.com/css2?family=Source+Serif+Pro:wght@300;400;600;700;900&display=swap');
      @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap');
      @import url('https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@300;400;500;600;700;800;900&display=swap');
      
      /* Option 1: Source Serif Pro + IBM Plex Sans */
      .sourceserif-headlines h1,
      .sourceserif-headlines h2,
      .sourceserif-headlines h3,
      .sourceserif-headlines h4,
      .sourceserif-headlines h5,
      .sourceserif-headlines h6 {
        font-family: 'Source Serif Pro', Georgia, serif !important;
        letter-spacing: -0.01em;
      }
      
      .sourceserif-body {
        font-family: 'IBM Plex Sans', -apple-system, sans-serif !important;
        letter-spacing: 0;
      }
      
      /* Option 2: Inter (All sizes) */
      .inter-headlines h1,
      .inter-headlines h2,
      .inter-headlines h3,
      .inter-headlines h4,
      .inter-headlines h5,
      .inter-headlines h6 {
        font-family: 'Inter', -apple-system, sans-serif !important;
        letter-spacing: -0.015em;
      }
      
      .inter-body {
        font-family: 'Inter', -apple-system, sans-serif !important;
        font-weight: 400;
        letter-spacing: -0.011em;
      }
      
      /* Option 3: Crimson Pro (All sizes) */
      .crimson-headlines h1,
      .crimson-headlines h2,
      .crimson-headlines h3,
      .crimson-headlines h4,
      .crimson-headlines h5,
      .crimson-headlines h6 {
        font-family: 'Crimson Pro', Georgia, serif !important;
        letter-spacing: -0.01em;
      }
      
      .crimson-body {
        font-family: 'Crimson Pro', Georgia, serif !important;
        letter-spacing: 0;
        font-weight: 400;
      }
      
      /* Option 4: Inter + IBM Plex Sans */
      .inter-plex-headlines h1,
      .inter-plex-headlines h2,
      .inter-plex-headlines h3,
      .inter-plex-headlines h4,
      .inter-plex-headlines h5,
      .inter-plex-headlines h6 {
        font-family: 'Inter', -apple-system, sans-serif !important;
        letter-spacing: -0.025em;
      }
      
      .plex-sans-body {
        font-family: 'IBM Plex Sans', -apple-system, sans-serif !important;
        letter-spacing: 0;
        font-weight: 400;
      }
    </style>

    <div class="mb-12">
      <div class="p-4 bg-color-100 rounded-lg">
        <p class="text-sm font-semibold mb-2">About this test</p>
        <p class="text-sm">
          Work Sans approximates Halyard Display for headlines.
          Inter approximates Halyard Text for body copy.
        </p>
      </div>
    </div>

    <!-- Current fonts -->
    <section class="mb-16">
      <h2 class="heading-3 mb-8">Current Typography (Newsreader + IBM Plex Sans)</h2>
      <div class="space-y-4">
        <h1 class="heading-1">The Quick Brown Fox</h1>
        <h2 class="heading-2">Pack my box with five dozen liquor jugs</h2>
        <p class="text-0">
          Typography is the craft of endowing human language with a durable visual form.
          Good typography is invisible, guiding readers through content effortlessly.
        </p>
      </div>
    </section>

    <!-- Typography Options -->
    <section class="mb-16">
      <h2 class="heading-3 mb-8">Typography Options</h2>
      
      <div class="space-y-12">
        <!-- Option 1 -->
        <div class="sourceserif-headlines sourceserif-body p-6 border border-color-200 rounded-lg">
          <p class="text-meta mb-4">Option 1: Source Serif Pro + IBM Plex Sans</p>
          <h1 class="heading-1">The Quick Brown Fox</h1>
          <h2 class="heading-2">Pack my box with five dozen liquor jugs</h2>
          <p class="text-0 mt-4">
            Typography is the craft of endowing human language with a durable visual form.
            Good typography is invisible, guiding readers through content effortlessly.
          </p>
        </div>
        
        <!-- Option 2 -->
        <div class="inter-headlines inter-body p-6 border border-color-200 rounded-lg">
          <p class="text-meta mb-4">Option 2: Inter (All sizes)</p>
          <h1 class="heading-1">The Quick Brown Fox</h1>
          <h2 class="heading-2">Pack my box with five dozen liquor jugs</h2>
          <p class="text-0 mt-4">
            Typography is the craft of endowing human language with a durable visual form.
            Good typography is invisible, guiding readers through content effortlessly.
          </p>
        </div>
        
        <!-- Option 3 -->
        <div class="crimson-headlines crimson-body p-6 border border-color-200 rounded-lg">
          <p class="text-meta mb-4">Option 3: Crimson Pro (All sizes)</p>
          <h1 class="heading-1">The Quick Brown Fox</h1>
          <h2 class="heading-2">Pack my box with five dozen liquor jugs</h2>
          <p class="text-0 mt-4">
            Typography is the craft of endowing human language with a durable visual form.
            Good typography is invisible, guiding readers through content effortlessly.
          </p>
        </div>
        
        <!-- Option 4 -->
        <div class="inter-plex-headlines plex-sans-body p-6 border border-color-200 rounded-lg">
          <p class="text-meta mb-4">Option 4: Inter + IBM Plex Sans</p>
          <h1 class="heading-1">The Quick Brown Fox</h1>
          <h2 class="heading-2">Pack my box with five dozen liquor jugs</h2>
          <p class="text-0 mt-4">
            Typography is the craft of endowing human language with a durable visual form.
            Good typography is invisible, guiding readers through content effortlessly.
          </p>
        </div>
      </div>
    </section>

    <!-- Side by side -->
    <section class="mb-16">
      <h2 class="heading-3 mb-8">Side by Side Comparison</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Current -->
        <div class="border border-color-200 rounded-lg p-6">
          <p class="text-meta mb-4">Current (Newsreader + IBM Plex Sans)</p>
          <h3 class="heading-3 mb-2">Typography Design</h3>
          <p class="text-sm">
