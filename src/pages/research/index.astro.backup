---
import { getCollection } from "astro:content";
import CompactList from "@/components/CompactList.astro";
import PageHeader from "@/components/PageHeader.astro";
import ResearchEntry from "@/components/ResearchEntry.astro";
import SectionSeparator from "@/components/SectionSeparator.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import BaseLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";

const allResearch = await getCollection("research");

// Group by status and featured
const featuredPapers = allResearch.filter(paper => paper.data.featured === true);
const publishedPapers = allResearch.filter(paper => paper.data.status === "published");
const workingPapers = allResearch.filter(paper => paper.data.status === "working-paper");
const worksInProgress = allResearch.filter(paper => paper.data.status === "work-in-progress");

// Sort by year (newest first)
const sortByYear = (papers: typeof allResearch) => [...papers].sort((a, b) => b.data.paperDate.localeCompare(a.data.paperDate));

// Create table of contents data
const tocSections = [
  { title: "New and Updated", href: "#featured", count: featuredPapers.length },
  { title: "Published Papers", href: "#published", count: publishedPapers.length },
  { title: "Working Papers", href: "#working", count: workingPapers.length },
  { title: "Works in Progress", href: "#wip", count: worksInProgress.length },
  { title: "Curriculum Vitae", href: siteConfig.resumeUrl || "/cv.pdf" }
];

const meta = {
  title: "Research",
  description: "Academic research on economics, technology, and digital transformation."
};
---

<BaseLayout meta={meta}>
  <div class="measure-base mx-auto px-4b py-8b">
    
    <!-- Reusable Page Header with proper typography and spacing -->
    <PageHeader 
      title="Research"
      description="My research focuses on the intersection of economics, technology, and digital transformation. I examine how technological change affects markets, productivity, and economic outcomes."
    />

    <!-- Table of Contents Block -->
    <div class="mb-12b">
      <TableOfContents sections={tocSections} />
    </div>

    <!-- Featured/Recent Papers Section -->
    {featuredPapers.length > 0 && (
      <section id="featured" class="mb-16b">
        <h2 class="heading-2 mb-8b">New and Updated</h2>
        <div class="space-y-6b">
          {sortByYear(featuredPapers).map((paper) => (
            <article class="featured-research-entry entry-divider">
              <h3 class="featured-research-title">
                <a href={`/research/${paper.id}/`} class="link-title">{paper.data.title}</a>
              </h3>
              
              <div class="featured-research-metadata text-meta text-meta--light">
                <span class="metadata-item">FEATURED</span>
                <span class="text-meta__separator" aria-hidden="true">•</span>
                <span class="metadata-item">{paper.data.paperDate}</span>
                {paper.data.authors && (
                  <>
                    <span class="text-meta__separator" aria-hidden="true">•</span>
                    <span class="metadata-item">{paper.data.authors}</span>
                  </>
                )}
              </div>
              
              {paper.data.publication && (
                <div class="text-publication">
                  {paper.data.publication}
                </div>
              )}
              
              {paper.data.description && (
                <p class="text-research-description">{paper.data.description}</p>
              )}
              
              <div class="featured-research-actions">
                <a href={`/research/${paper.id}/`} class="link-research-action">
                  <span>View Details</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Wide Full Header Line Separator -->
    {featuredPapers.length > 0 && <SectionSeparator variant="full-width" spacing="normal" />}

    <!-- Published Papers -->
    {publishedPapers.length > 0 && (
      <section id="published" class="mb-16b">
        <h2 class="heading-2 mb-8b">Published Papers</h2>
        <div class="space-y-8b">
          {sortByYear(publishedPapers).map((paper) => (
            <ResearchEntry
              title={paper.data.title}
              href={`/research/${paper.id}/`}
              date={paper.data.paperDate}
              status={paper.data.status}
              metadata={paper.data.authors}
              description={paper.data.description}
              publication={paper.data.publication}
              download={paper.data.download}
              link={paper.data.link}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Wide Full Header Line Separator -->
    {publishedPapers.length > 0 && workingPapers.length > 0 && (
      <SectionSeparator variant="full-width" spacing="normal" />
    )}

    <!-- Working Papers -->
    {workingPapers.length > 0 && (
      <section id="working" class="mb-16b">
        <h2 class="heading-2 mb-8b">Working Papers</h2>
        <div class="space-y-8b">
          {sortByYear(workingPapers).map((paper) => (
            <ResearchEntry
              title={paper.data.title}
              href={`/research/${paper.id}/`}
              date={paper.data.paperDate}
              status={paper.data.status}
              metadata={paper.data.authors}
              description={paper.data.description}
              publication={paper.data.publication}
              download={paper.data.download}
              link={paper.data.link}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Wide Full Header Line Separator -->
    {(publishedPapers.length > 0 || workingPapers.length > 0) && worksInProgress.length > 0 && (
      <SectionSeparator variant="full-width" spacing="normal" />
    )}

    <!-- Works in Progress -->
    {worksInProgress.length > 0 && (
      <section id="wip" class="mb-16b">
        <h2 class="heading-2 mb-8b">Works in Progress</h2>
        <CompactList 
          items={sortByYear(worksInProgress).map((paper) => ({
            title: paper.data.title,
            description: `${paper.data.authors} • ${paper.data.paperDate}`,
            url: `/research/${paper.id}/`,
          }))}
        />
      </section>
    )}



  </div>
</BaseLayout>

<style>
  /* Featured research entries - consistent with ResearchEntry styling */
  .featured-research-entry {
    margin-bottom: var(--space-6); /* 36px - consistent spacing */
  }
  
  .featured-research-entry:last-child {
    margin-bottom: 0;
  }
  
  /* Featured title typography - matching refined ResearchEntry */
  .featured-research-title {
    font-size: var(--step-1); /* 15.6-18px - same as ResearchEntry */
    font-weight: 525; /* Slightly heavier for distinction */
    line-height: 1.3; /* Tighter for impact */
    margin-bottom: var(--space-2); /* 12px - breathing room */
    
    /* Enhanced OpenType features */
    font-feature-settings:
      "kern" 1,
      "liga" 1,
      "calt" 1;
    
    /* Ruder: slight negative tracking for display sizes */
    letter-spacing: -0.01em;
  }
  
  /* Featured metadata styling */
  .featured-research-metadata {
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: wrap;
    line-height: 1.5;
    margin-bottom: var(--space-1); /* 6px */
  }
  
  /* Featured action container */
  .featured-research-actions {
    margin-top: var(--space-2); /* 12px */
  }
  
  /* Smooth scroll for anchor links */
  html {
    scroll-behavior: smooth;
  }
  
  /* Target highlighting when navigating to sections */
  section:target {
    scroll-margin-top: 2rem;
  }
  
  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .featured-research-title {
      font-weight: 600;
    }
  }
</style>