---
import { getCollection } from "astro:content";
import CompactList from "@/components/CompactList.astro";
import PageHeader from "@/components/PageHeader.astro";
import ResearchEntry from "@/components/ResearchEntry.astro";
import SectionSeparator from "@/components/SectionSeparator.astro";
import BaseLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";

const allResearch = await getCollection("research");

// Group by status and featured
const featuredPapers = allResearch.filter(paper => paper.data.featured === true);
const publishedPapers = allResearch.filter(paper => paper.data.status === "published");
const workingPapers = allResearch.filter(paper => paper.data.status === "working-paper");
const worksInProgress = allResearch.filter(paper => paper.data.status === "work-in-progress");

// Sort by year (newest first)
const sortByYear = (papers: typeof allResearch) => [...papers].sort((a, b) => b.data.paperDate.localeCompare(a.data.paperDate));

const meta = {
  title: "Research",
  description: "Academic research on economics, technology, and digital transformation."
};
---

<BaseLayout meta={meta}>
  <div class="measure-base mx-auto px-4b py-8b">
    
    <!-- Reusable Page Header with proper typography and spacing -->
    <PageHeader 
      title="Research"
      description="My research focuses on the intersection of economics, technology, and digital transformation. I examine how technological change affects markets, productivity, and economic outcomes."
      additionalInfo={`<a href="${siteConfig.resumeUrl}">Download CV</a> • Also see <a href="/writing">writing</a> and <a href="/projects">projects</a>`}
    />

    <!-- Featured/Recent Papers Section -->
    {featuredPapers.length > 0 && (
      <section class="mb-12b">
        <h2 class="heading-3 mb-6b">Recent and Updated</h2>
        <ul class="space-y-3b">
          {sortByYear(featuredPapers).map((paper) => (
            <li class="flex items-baseline justify-between gap-4b">
              <span class="text-0 flex-1">{paper.data.title}</span>
              <a href={`/research/${paper.id}/`} class="nav-link text-meta uppercase tracking-wide whitespace-nowrap">
                View →
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Wide Full Header Line Separator -->
    {featuredPapers.length > 0 && <SectionSeparator variant="full-width" spacing="normal" />}

    <!-- Published Papers -->
    {publishedPapers.length > 0 && (
      <section id="published" class="mb-16b">
        <h2 class="heading-2 mb-8b">Published Papers</h2>
        <div class="space-y-8b">
          {sortByYear(publishedPapers).map((paper) => (
            <ResearchEntry
              title={paper.data.title}
              href={`/research/${paper.id}/`}
              date={paper.data.paperDate}
              status={paper.data.status}
              metadata={paper.data.authors}
              publication={paper.data.publication}
              download={paper.data.download}
              link={paper.data.link}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Wide Full Header Line Separator -->
    {publishedPapers.length > 0 && workingPapers.length > 0 && (
      <SectionSeparator variant="full-width" spacing="normal" />
    )}

    <!-- Working Papers -->
    {workingPapers.length > 0 && (
      <section id="working" class="mb-16b">
        <h2 class="heading-2 mb-8b">Working Papers</h2>
        <div class="space-y-8b">
          {sortByYear(workingPapers).map((paper) => (
            <ResearchEntry
              title={paper.data.title}
              href={`/research/${paper.id}/`}
              date={paper.data.paperDate}
              status={paper.data.status}
              metadata={paper.data.authors}
              publication={paper.data.publication}
              download={paper.data.download}
              link={paper.data.link}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Wide Full Header Line Separator -->
    {(publishedPapers.length > 0 || workingPapers.length > 0) && worksInProgress.length > 0 && (
      <SectionSeparator variant="full-width" spacing="normal" />
    )}

    <!-- Works in Progress -->
    {worksInProgress.length > 0 && (
      <section id="wip" class="mb-16b">
        <h2 class="heading-2 mb-8b">Works in Progress</h2>
        <CompactList 
          items={sortByYear(worksInProgress).map((paper) => ({
            title: paper.data.title,
            description: `${paper.data.authors} • ${paper.data.paperDate}`,
            url: `/research/${paper.id}/`,
          }))}
        />
      </section>
    )}



  </div>
</BaseLayout>

<style>
  /* Navigation link styling consistent with other pages */
  .nav-link {
    color: var(--theme-color-600);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  
  .nav-link:hover {
    color: var(--theme-text);
  }
  
  /* Smooth scroll for anchor links */
  html {
    scroll-behavior: smooth;
  }
  
  /* Target highlighting when navigating to sections */
  section:target {
    scroll-margin-top: 2rem;
  }
</style>