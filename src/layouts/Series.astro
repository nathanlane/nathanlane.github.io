---
import { type CollectionEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import TOC from "@/components/blog/TOC.astro";
import SeriesPanel from "@/components/SeriesPanel.astro";
import BaseLayout from "./Base.astro";

interface Props {
	series: CollectionEntry<"series">;
}

const { series } = Astro.props;
const { title, description } = series.data;

const { headings } = await render(series);
---

<BaseLayout meta={{ description, title }}>

	<!-- SeriesPanel is inserted into named slot "sidebar" -->
	{series.id && (<SeriesPanel slot="sidebar" seriesId={series.id} />)}

	<div class="flex items-center">
		<button
			type="button"
			id="toggle-panel"
			class="hidden md:flex z-30 mr-2b btn-icon-nav"
			aria-label="Toggle Series Panel"
			aria-controls="series-panel"
		>
			<Icon aria-hidden="true" class="flex-shrink-0 icon-action" focusable="false" name="lucide:file-text" />
		</button>
		<button
			type="button"
			id="toggle-toc"
			class="hidden md:flex z-30 mr-2b btn-icon-nav"
			aria-label="Toggle Table of Contents"
			aria-controls="toc-panel"
		>	
			<Icon aria-hidden="true" class="icon-action" focusable="false" name="lucide:list" />
		</button>

		<h1 class="text-5 title line-clamp-none md:line-clamp-1 md:max-w-lg lg:max-w-xl">
			{title}
		</h1>
	</div>
	<p class="prose prose-lane max-w-none mt-4b">
		{description}
	</p>

	<div class="mt-6b flex sm:grid-cols-[auto_1fr] md:items-start gap-x-12">
		<article class="grid flex-grow grid-cols-1 break-words pt-4b">
			<div class="prose prose-lane prose-serif max-w-none flex-grow prose-headings:text-accent-base">
				<slot />
			</div>
		</article>
		{
			!!headings.length && (
				<aside 
					id="toc-panel" 
					class="z-10 hidden md:w-[16rem] md:min-w-[16rem] rounded-lg md:block"
				>
					<TOC headings={headings} />
				</aside>
			)
		}
	</div>


	<!-- Series button for mobile screens -->
	<button
		type="button"
		id="toggle-panel-mobile"
		class="btn-icon-fab block sm:hidden absolute bottom-4 right-4 z-50"
		aria-label="Toggle Series Panel"
		aria-controls="series-panel"
	>
		<span class="absolute inset-0 rounded-lg flex items-center justify-center bg-special-light hover:text-accent-base/90">
			<Icon class="icon-action" name="lucide:file-text"/>
		</span>
	</button>
</BaseLayout>

<script>
	import { initializePanelToggle } from '@/utils/panelToggle';
	
	// Initialize Series Panel toggle
	initializePanelToggle({
		panelId: 'series-panel',
		toggleButtonId: 'toggle-panel',
		mobileToggleButtonId: 'toggle-panel-mobile',
		closeButtonId: 'close-panel',
		breakpoint: 'lg',
		visibleClass: 'lg:block'
	});
	
	// Initialize TOC Panel toggle
	initializePanelToggle({
		panelId: 'toc-panel',
		toggleButtonId: 'toggle-toc',
		mobileToggleButtonId: 'toggle-toc-mobile',
		closeButtonId: 'close-toc',
		breakpoint: 'md',
		visibleClass: 'md:block'
	});
</script>


