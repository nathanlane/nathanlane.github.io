---
import { type CollectionEntry, render } from "astro:content";
import SeriesPanel from "@/components/SeriesPanel.astro";
import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";
import { Icon } from "astro-icon/components";
import BaseLayout from "./Base.astro";
import type { LayoutStructuredData } from "@/types";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate, seriesId } = post.data;

const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);

// Calculate reading time and word count
const readingTime = remarkPluginFrontmatter?.minutesRead || 5;
const wordCount = remarkPluginFrontmatter?.words || 1000;

// Format date for display
const formatDate = (date: Date) => {
	return date.toLocaleDateString("en-US", { 
		year: "numeric", 
		month: "long", 
		day: "numeric" 
	}).toUpperCase();
};

// Prepare article data for structured data
const articleData = {
	url: Astro.url.pathname,
	title,
	description,
	publishDate: publishDate.toISOString(),
	updatedDate: updatedDate?.toISOString(),
	ogImage: socialImage,
	tags: post.data.tags,
	minutesRead: remarkPluginFrontmatter?.minutesRead as number | undefined
};

// Prepare breadcrumb data
const breadcrumbData = {
	items: [
		{ name: "Home", url: Astro.site?.href || "/" },
		{ name: "Posts", url: new URL("/posts/", Astro.site).href },
		{ name: title, url: new URL(Astro.url.pathname, Astro.site).href }
	]
};

// Structured data array for SEO
const structuredData: LayoutStructuredData[] = [
	{ type: 'article', data: articleData },
	{ type: 'breadcrumb', data: breadcrumbData }
];
---

<BaseLayout meta={{ articleDate, description, ogImage: socialImage, title }} structuredData={structuredData}>
 	<!-- SeriesPanel is inserted into the named slot "sidebar" -->
	{seriesId && (<SeriesPanel slot="sidebar" seriesId={seriesId} />)}

	<!-- Essay layout with editorial aesthetic -->
	<article class="essay-wrapper" data-content-type="long-form">
		<!-- Back navigation -->
		<nav class="essay-nav-inline">
			<a href="/posts" class="back-link">← All Essays</a>
		</nav>

		<!-- Essay header with metadata -->
		<header class="essay-header">
			<h1 class="essay-title">{title}</h1>
			<hr class="essay-separator" />
			<div class="essay-metadata">
				ESSAY • {formatDate(publishDate)} • {wordCount.toLocaleString()} WORDS • {readingTime} MIN READ
			</div>
		</header>

		<!-- Essay content with prose styling -->
		<div class="essay-content prose prose-lane max-w-none">
			<slot />
		</div>

		<!-- WebMentions -->
		<div class="essay-webmentions">
			<WebMentions />
		</div>

		<!-- Table of Contents - positioned absolutely on desktop -->
		{!!headings.length && (
			<aside 
				id="toc-panel" 
				class="essay-toc hidden md:block"
			>
				<TOC headings={headings} />
			</aside>
		)}
	</article>

	<!-- Series button for mobile screens -->
	{seriesId && (
		<mobile-button
			id="toggle-panel-mobile"
			class="btn-icon-fab block sm:hidden absolute bottom-space-s right-space-s z-50"
			aria-label="Toggle Series Panel"
		>
			<span class="absolute inset-0 rounded-lg flex items-center justify-center bg-special-light hover:text-accent-base/90">
				<Icon class="icon-action" name="lucide:file-text"/>
			</span>
		</mobile-button>
	)}
</BaseLayout>

<!-- Copy code button -->
<script>
	// Wait for the content to fully load
	document.addEventListener("DOMContentLoaded", () => {
		// Find all pre blocks
		document.querySelectorAll("pre").forEach((pre) => {
			// Check if the button already exists
			if (!pre.querySelector(".copy-code")) {
				// Ensure pre has position relative for absolute button
				pre.style.position = "relative";
				
				// Create the button
				const copyButton = document.createElement("button");
				copyButton.className =
				"copy-code absolute flex items-center justify-center font-medium rounded-md font-sans text-xs top-3 right-3 z-10 border border-color-200 bg-bgColor/90 backdrop-blur-sm hover:bg-bgColor hover:border-color-300 transition-all duration-150";

				// Create the span element that will hold the button text
				const buttonText = document.createElement("span");
				buttonText.innerText = "Copy"; // Initial text
				buttonText.className = "flex items-center px-3 py-1 text-xs font-medium text-light"; // Elegant button styling

				copyButton.appendChild(buttonText); // Append span to the button

				// Add the button inside pre
				pre.appendChild(copyButton);

				// Event handler for copying text
				copyButton.addEventListener("click", async () => {
					const code = pre.querySelector("code")?.textContent;
					if (code) {
						await navigator.clipboard.writeText(code);
						buttonText.innerText = "Copied!";
						copyButton.classList.add("text-accent-base");
						copyButton.classList.remove("text-light");
						// Reset after 2 seconds
						setTimeout(() => {
							buttonText.innerText = "Copy";
							copyButton.classList.remove("text-accent-base");
							copyButton.classList.add("text-light");
						}, 2000);
					}
				});
			}
		});
	});
</script>

<script>
	import { initializePanelToggle } from '@/utils/panelToggle';
	
	// Initialize Series Panel toggle
	initializePanelToggle({
		panelId: 'series-panel',
		toggleButtonId: 'toggle-panel',
		mobileToggleButtonId: 'toggle-panel-mobile',
		closeButtonId: 'close-panel',
		breakpoint: 'lg',
		visibleClass: 'lg:block'
	});
	
	// Initialize TOC Panel toggle
	initializePanelToggle({
		panelId: 'toc-panel',
		toggleButtonId: 'toggle-toc',
		mobileToggleButtonId: 'toggle-toc-mobile',
		closeButtonId: 'close-toc',
		breakpoint: 'md',
		visibleClass: 'md:block'
	});
</script>

